page {
  background: #fff7fb;
  color: #333;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 170rpx;
}

.hero {
  background: linear-gradient(135deg, #ffd6e7, #ffeef5);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 143, 177, 0.12);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin: 20rpx 0;
}

.section-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.primary-btn {
  background: #ff8fb1;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.2;
  padding: 18rpx 28rpx;
}

.secondary-btn {
  background: #fff0f5;
  color: #ff5f90;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.2;
  padding: 18rpx 24rpx;
}

.small-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #fff0f5;
  color: #ff5f90;
  border-radius: 16rpx;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  margin-left: 12rpx;
}

.danger-btn {
  background: #fff2f2;
  color: #ff5a5a;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  box-sizing: border-box;
  background: #fff7fb;
  border: 1px solid #ffd7e5;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-top: 12rpx;
}

.textarea {
  min-height: 180rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #fff0f5;
  color: #ff5f90;
  margin-right: 12rpx;
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal {
  width: 100%;
  max-height: 85vh;
  overflow: auto;
  box-sizing: border-box;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 24rpx 36rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 26rpx;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.mt12 {
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1px solid #f5e7ee;
}

.info-label {
  color: #888;
}

.preview-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: #f6f6f6;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tip-box {
  background: #fff8e8;
  color: #8a6b1e;
  border-radius: 20rpx;
  padding: 22rpx;
  line-height: 1.7;
}

.status-text-done {
  color: #999;
  text-decoration: line-through;
}

.status-strong {
  background: #fff1f1;
  color: #ff5a5a;
}