page {
  background: #fdf9ef;
  color: #5a4632;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 220rpx;
}

.page-topbar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 900;
  height: calc(env(safe-area-inset-top) + 184rpx);
  margin: -24rpx -24rpx 0;
  padding: 0 24rpx;
  background: linear-gradient(180deg, #f7e3ae 0%, #f1d28a 100%);
  box-sizing: border-box;
}

.page-topbar-inner {
  height: 100%;
  min-height: 0;
  padding: 0 170rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #fbf6ea 0%, #fff7df 54%, #f7f8ef 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1px solid #eee3ce;
  box-shadow: 0 16rpx 36rpx rgba(187, 177, 144, 0.12);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5a4632;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8f7b67;
  line-height: 1.6;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card {
  background: rgba(255, 255, 253, 0.96);
  border-radius: 30rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1px solid #efe4d0;
  box-shadow: 0 16rpx 34rpx rgba(193, 179, 143, 0.11);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin: 20rpx 0;
}

.section-sub {
  display: block;
  font-size: 24rpx;
  color: #9d8b78;
  margin-top: 8rpx;
}

.primary-btn {
  background: linear-gradient(180deg, #acc28d, #95ac78);
  color: #fffdf8;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.2;
  padding: 18rpx 28rpx;
  box-shadow: 0 10rpx 22rpx rgba(148, 168, 118, 0.22);
}

.secondary-btn {
  background: #fff5df;
  color: #b18845;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.2;
  padding: 18rpx 24rpx;
  border: 1px solid #f0dfb9;
}

.small-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #f4f4e8;
  color: #8c9b73;
  border-radius: 16rpx;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  margin-left: 12rpx;
  border: 1px solid #dde4cd;
}

.danger-btn {
  background: #fff2e8;
  color: #d07a5f;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  box-sizing: border-box;
  background: #fffdf8;
  border: 1px solid #ece2cf;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-top: 12rpx;
}

.textarea {
  min-height: 180rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #8f7b67;
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef3e5;
  color: #87996e;
  margin-right: 12rpx;
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  color: #b29f8a;
  padding: 60rpx 0;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal {
  width: 100%;
  max-height: 85vh;
  overflow: auto;
  box-sizing: border-box;
  background: #fffefb;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 24rpx 36rpx;
  border-top: 1px solid #ece1cd;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 26rpx;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.mt12 {
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1px solid #efe5d4;
}

.info-label {
  color: #9f8d78;
}

.preview-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: #f6f6f6;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tip-box {
  background: linear-gradient(180deg, #fff6da, #fffdf0);
  color: #99763c;
  border-radius: 20rpx;
  padding: 22rpx;
  line-height: 1.7;
  border: 1px solid #efe0b6;
}

.status-text-done {
  color: #b4a691;
  text-decoration: line-through;
}

.status-strong {
  background: #fff0e8;
  color: #d07a5f;
}
