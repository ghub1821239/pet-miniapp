page {
  background: #FCE7C8;
  color: #5B4A3A;
  font-size: 28rpx;
  font-family: 'Avenir Next', 'Trebuchet MS', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
}

button::after {
  border: none;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 220rpx;
  background: #FFFDF6;
}

.page-topbar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 900;
  height: calc(env(safe-area-inset-top) + 160rpx);
  margin: -24rpx -24rpx 0;
  padding: 0 24rpx;
  background: #F7E3AE;
  border-bottom: 1px solid rgba(247, 227, 174, 0.8);
  box-sizing: border-box;
  backdrop-filter: saturate(150%) blur(6rpx);
}

.page-topbar-inner {
  height: 100%;
  min-height: 0;
  padding: 0 170rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.hero {
  background: #FFFDF6;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1px solid rgba(250, 218, 122, 0.4);
  box-shadow: 0 10rpx 24rpx rgba(91, 74, 58, 0.08);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9A8B7A;
  line-height: 1.6;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card {
  background: #FFFDF6;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1px solid rgba(250, 218, 122, 0.35);
  box-shadow: 0 8rpx 22rpx rgba(91, 74, 58, 0.06);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5B4A3A;
  margin: 16rpx 0;
}

.section-sub {
  display: block;
  font-size: 23rpx;
  color: #9A8B7A;
  margin-top: 8rpx;
}

.primary-btn {
  background: #9CAF88;
  color: #FFFDF6;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.2;
  padding: 20rpx 30rpx;
  font-weight: 700;
}

.primary-btn[disabled] {
  background: #EEF5EA;
  color: #9A8B7A;
}

.secondary-btn {
  background: #FFFDF6;
  color: #5B4A3A;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.2;
  padding: 18rpx 24rpx;
  border: 1px solid rgba(250, 218, 122, 0.55);
}

.small-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #EEF5EA;
  color: #7F956D;
  border-radius: 16rpx;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  margin-left: 12rpx;
  border: 1px solid rgba(156, 175, 136, 0.24);
}

.danger-btn {
  background: #FFF4EA;
  color: #9A8B7A;
  border-color: #FADA7A;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  box-sizing: border-box;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.45);
  border-radius: 18rpx;
  padding: 20rpx;
  margin-top: 12rpx;
  color: #5B4A3A;
}

.textarea {
  min-height: 180rpx;
}

.field-label {
  display: block;
  font-size: 25rpx;
  color: #9A8B7A;
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #EEF5EA;
  color: #7F956D;
  margin-right: 12rpx;
  margin-top: 8rpx;
  border: 1px solid rgba(156, 175, 136, 0.24);
}

.empty {
  text-align: center;
  color: #9A8B7A;
  padding: 60rpx 0;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #5B4A3A;
  font-weight: 700;
}

.empty-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9A8B7A;
  line-height: 1.6;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(91, 74, 58, 0.34);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal {
  width: 100%;
  max-height: 85vh;
  overflow: auto;
  box-sizing: border-box;
  background: #FFFDF6;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 24rpx 36rpx;
  border-top: 1px solid rgba(250, 218, 122, 0.45);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 26rpx;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.mt12 {
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1px solid rgba(250, 218, 122, 0.32);
}

.info-label {
  color: #9A8B7A;
}

.preview-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: #FFF8E5;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tip-box {
  background: #FFF4D1;
  color: #5B4A3A;
  border-radius: 20rpx;
  padding: 22rpx;
  line-height: 1.7;
  border: 1px solid #FADA7A;
}
