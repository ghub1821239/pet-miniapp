page {
  background: #f5f5f5;
  color: #151515;
  font-size: 28rpx;
  font-family: 'Avenir Next', 'Trebuchet MS', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
}

button::after {
  border: none;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 220rpx;
  background: #f5f5f5;
}

.page-topbar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 900;
  height: calc(env(safe-area-inset-top) + 160rpx);
  margin: -24rpx -24rpx 0;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid #ebebeb;
  box-sizing: border-box;
  backdrop-filter: saturate(150%) blur(6rpx);
}

.page-topbar-inner {
  height: 100%;
  min-height: 0;
  padding: 0 170rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.hero {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1px solid #ebebeb;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.06);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #151515;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b6b6b;
  line-height: 1.6;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1px solid #ececec;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #151515;
  margin: 16rpx 0;
}

.section-sub {
  display: block;
  font-size: 23rpx;
  color: #7a7a7a;
  margin-top: 8rpx;
}

.primary-btn {
  background: #e60023;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.2;
  padding: 20rpx 30rpx;
  font-weight: 700;
}

.primary-btn[disabled] {
  background: #f3b3bf;
  color: #fff;
}

.secondary-btn {
  background: #ffffff;
  color: #242424;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.2;
  padding: 18rpx 24rpx;
  border: 1px solid #d8d8d8;
}

.small-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #f4f4f4;
  color: #3d3d3d;
  border-radius: 16rpx;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  margin-left: 12rpx;
  border: 1px solid #e3e3e3;
}

.danger-btn {
  background: #ffe8ee;
  color: #b00020;
  border-color: #ffd0db;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border: 1px solid #e4e4e4;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-top: 12rpx;
  color: #1e1e1e;
}

.textarea {
  min-height: 180rpx;
}

.field-label {
  display: block;
  font-size: 25rpx;
  color: #5a5a5a;
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #f4f4f4;
  color: #555;
  margin-right: 12rpx;
  margin-top: 8rpx;
  border: 1px solid #ececec;
}

.empty {
  text-align: center;
  color: #8a8a8a;
  padding: 60rpx 0;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #2b2b2b;
  font-weight: 700;
}

.empty-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8d8d8d;
  line-height: 1.6;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal {
  width: 100%;
  max-height: 85vh;
  overflow: auto;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 24rpx 36rpx;
  border-top: 1px solid #ebebeb;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #151515;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 26rpx;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.mt12 {
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.info-label {
  color: #818181;
}

.preview-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: #f6f6f6;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tip-box {
  background: #fff1f4;
  color: #8f2137;
  border-radius: 20rpx;
  padding: 22rpx;
  line-height: 1.7;
  border: 1px solid #ffd8e1;
}
