.pet-tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.pet-tabbar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #e8e8e8;
  border-radius: 0;
  padding: 8rpx 24rpx calc(8rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.tab-side {
  flex: 1;
  display: flex;
  align-items: center;
}

.tab-center-slot {
  width: 168rpx;
  flex-shrink: 0;
  height: 98rpx;
  position: relative;
}

.tab-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 6rpx 0 2rpx;
  color: #8a8a8a;
  border-radius: 999rpx;
}

.tab-item.active {
  background: #f2f2f2;
  color: #151515;
}

.tab-icon {
  display: block;
  width: 50rpx;
  height: 50rpx;
  margin: 0 auto;
}

.tab-icon-community,
.tab-icon-calendar {
  width: 48rpx;
  height: 48rpx;
}

.tab-icon-consult {
  width: 44rpx;
  height: 44rpx;
}

.tab-icon-pet {
  width: 42rpx;
  height: 42rpx;
}

.tab-text {
  display: block;
  font-size: 18rpx;
  margin-top: 2rpx;
}

.tab-center-item {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: -24rpx;
  height: 112rpx;
  border-radius: 40rpx;
  background: #e60023;
  color: #fff;
  box-shadow: 0 18rpx 34rpx rgba(230, 0, 35, 0.32);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #ffffff;
  margin: 0 auto;
}

.tab-center-item.active {
  box-shadow: 0 22rpx 42rpx rgba(230, 0, 35, 0.4);
}

.tab-center-icon {
  display: block;
  width: 58rpx;
  height: 58rpx;
}

.tab-center-text {
  display: block;
  font-size: 20rpx;
  margin-top: 6rpx;
  line-height: 1;
}
