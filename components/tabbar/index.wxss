.pet-tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.pet-tabbar {
  display: flex;
  align-items: center;
  background: rgba(255, 253, 246, 0.98);
  border-top: 1px solid rgba(250, 218, 122, 0.45);
  border-radius: 0;
  padding: 8rpx 24rpx calc(8rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 18rpx rgba(91, 74, 58, 0.08);
}

.tab-side {
  flex: 1;
  display: flex;
  align-items: center;
}

.tab-center-slot {
  width: 168rpx;
  flex-shrink: 0;
  height: 98rpx;
  position: relative;
}

.tab-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 6rpx 0 2rpx;
  color: #9A8B7A;
  border-radius: 999rpx;
}

.tab-item.active {
  background: #EEF5EA;
  color: #5B4A3A;
}

.tab-icon {
  display: block;
  width: 50rpx;
  height: 50rpx;
  margin: 0 auto;
}

.tab-icon-community,
.tab-icon-calendar {
  width: 48rpx;
  height: 48rpx;
}

.tab-icon-consult {
  width: 44rpx;
  height: 44rpx;
}

.tab-icon-pet {
  width: 42rpx;
  height: 42rpx;
}

.tab-text {
  display: block;
  font-size: 18rpx;
  margin-top: 2rpx;
}

.tab-center-item {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: -24rpx;
  height: 112rpx;
  border-radius: 40rpx;
  background: #9CAF88;
  color: #FFFDF6;
  box-shadow: 0 18rpx 34rpx rgba(156, 175, 136, 0.32);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #FFFDF6;
  margin: 0 auto;
}

.tab-center-item.active {
  box-shadow: 0 22rpx 42rpx rgba(156, 175, 136, 0.4);
}

.tab-center-icon {
  display: block;
  width: 58rpx;
  height: 58rpx;
}

.tab-center-text {
  display: block;
  font-size: 20rpx;
  margin-top: 6rpx;
  line-height: 1;
}
