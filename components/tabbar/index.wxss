.pet-tabbar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  z-index: 1000;
  display: flex;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 12rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  color: #999;
}

.tab-item.active {
  background: #fff0f5;
  color: #ff5f90;
  border-radius: 999rpx;
}

.tab-icon {
  display: block;
  font-size: 36rpx;
}

.tab-text {
  display: block;
  font-size: 22rpx;
  margin-top: 6rpx;
}