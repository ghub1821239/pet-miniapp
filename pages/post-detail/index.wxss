.post-detail-page {
  min-height: 100vh;
  background: #FCE7C8;
  color: #5B4A3A;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  height: 118rpx;
  padding: calc(env(safe-area-inset-top) + 80rpx) 24rpx 12rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  background: rgba(255, 253, 246, 0.98);
  border-bottom: 1px solid rgba(250, 218, 122, 0.35);
}

.detail-back,
.detail-share {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #5B4A3A;
  font-size: 64rpx;
  line-height: 1;
}

.detail-share {
  font-size: 46rpx;
}

.detail-author {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  margin-left: 10rpx;
}

.detail-author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFF8E5;
  flex-shrink: 0;
  display: block;
}

.detail-author-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EEF5EA;
  color: #9A8B7A;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-author-copy {
  min-width: 0;
  margin-left: 18rpx;
}

.detail-author-name {
  display: block;
  color: #5B4A3A;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-author-meta {
  display: block;
  color: #9A8B7A;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-follow {
  flex-shrink: 0;
  min-width: 142rpx;
  height: 62rpx;
  padding: 0 26rpx;
  margin: 0 14rpx;
  border-radius: 999rpx;
  background: #FFFDF6;
  border: 1px solid #9CAF88;
  color: #7F956D;
  font-size: 28rpx;
  line-height: 62rpx;
  box-sizing: border-box;
}

.detail-follow.is-following {
  border-color: rgba(250, 218, 122, 0.45);
  color: #9A8B7A;
  background: #FCE7C8;
}

.detail-gallery {
  width: 100%;
  height: 920rpx;
  background: #FFF8E5;
}

.detail-gallery-image {
  width: 100%;
  height: 100%;
  display: block;
}

.detail-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  column-gap: 12rpx;
  height: 54rpx;
  background: #FFFDF6;
}

.detail-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d4d4d4;
}

.detail-dot.active {
  width: 16rpx;
  height: 16rpx;
  background: #9CAF88;
}

.detail-content {
  margin-top: 10rpx;
  background: #FFFDF6;
  padding: 20rpx 30rpx 28rpx;
  border-bottom: 1px solid #FFF8E5;
}

.detail-title {
  display: block;
  color: #5B4A3A;
  font-size: 42rpx;
  line-height: 1.38;
  font-weight: 800;
}

.detail-text {
  display: block;
  margin-top: 18rpx;
  color: #5B4A3A;
  font-size: 31rpx;
  line-height: 1.72;
}

.detail-topic-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.detail-topic {
  margin: 12rpx 14rpx 0 0;
  color: #7F956D;
  font-size: 28rpx;
  line-height: 1.35;
}

.detail-post-meta {
  display: flex;
  align-items: center;
  column-gap: 20rpx;
  margin-top: 24rpx;
  color: #9A8B7A;
  font-size: 24rpx;
}

.detail-comments {
  margin-top: 10rpx;
  padding: 26rpx 30rpx 14rpx;
  background: #FFFDF6;
}

.detail-comments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.detail-comments-title {
  color: #5B4A3A;
  font-size: 30rpx;
  font-weight: 800;
}

.detail-comments-sort {
  color: #9A8B7A;
  font-size: 24rpx;
}

.detail-comment {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1px solid #EEF5EA;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #EEF5EA;
  color: #9A8B7A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.comment-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.comment-line {
  display: flex;
  align-items: center;
  column-gap: 14rpx;
}

.comment-user {
  color: #9A8B7A;
  font-size: 25rpx;
}

.comment-time {
  color: #9A8B7A;
  font-size: 22rpx;
}

.comment-content {
  display: block;
  margin-top: 8rpx;
  color: #5B4A3A;
  font-size: 28rpx;
  line-height: 1.55;
}

.comment-like {
  width: 78rpx;
  flex-shrink: 0;
  text-align: center;
  color: #9A8B7A;
  font-size: 22rpx;
}

.comment-like.active {
  color: #9CAF88;
}

.comment-like-icon {
  display: block;
  font-size: 34rpx;
  line-height: 1;
}

.detail-actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  min-height: 104rpx;
  padding: 14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 246, 0.98);
  border-top: 1px solid rgba(250, 218, 122, 0.35);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.comment-input-wrap {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  display: flex;
  align-items: center;
}

.comment-pencil {
  color: #9A8B7A;
  font-size: 34rpx;
  margin-right: 10rpx;
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  font-size: 28rpx;
  color: #5B4A3A;
}

.action-item {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  color: #5B4A3A;
}

.action-item.active {
  color: #9CAF88;
}

.action-icon {
  font-size: 54rpx;
  line-height: 1;
}

.action-count {
  margin-left: 8rpx;
  font-size: 28rpx;
  line-height: 1;
}
