.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FCE7C8 0%, #FFF3E3 42%, #FFFDF6 100%);
  color: #5B4A3A;
}

.login-bg-bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 253, 246, 0.42);
  filter: blur(1rpx);
}

.login-bg-bubble-a {
  width: 280rpx;
  height: 280rpx;
  right: -90rpx;
  top: 120rpx;
}

.login-bg-bubble-b {
  width: 220rpx;
  height: 220rpx;
  left: -80rpx;
  bottom: 160rpx;
  background: rgba(238, 245, 234, 0.62);
}

.login-shell {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 54rpx) 34rpx 54rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.login-hero {
  text-align: center;
  padding: 8rpx 18rpx 0;
}

.login-kicker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 246, 0.72);
  color: #7F956D;
  font-size: 23rpx;
  font-weight: 800;
  border: 1px solid rgba(156, 175, 136, 0.22);
}

.login-title {
  display: block;
  margin-top: 26rpx;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 900;
  color: #5B4A3A;
}

.login-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #9A8B7A;
}

.login-icon-slot {
  width: 184rpx;
  height: 184rpx;
  margin: 34rpx auto -34rpx;
  border-radius: 50%;
  padding: 10rpx;
  box-sizing: border-box;
  background: rgba(255, 253, 246, 0.88);
  border: 1px solid rgba(250, 218, 122, 0.56);
  box-shadow: 0 18rpx 36rpx rgba(91, 74, 58, 0.10);
  z-index: 3;
}

.login-icon-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFFDF6 0%, #EEF5EA 100%);
  border: 2rpx dashed rgba(156, 175, 136, 0.42);
  overflow: hidden;
}

.login-default-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.login-card {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  margin-top: 0;
  padding: 72rpx 28rpx 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 253, 246, 0.96);
  border: 1px solid rgba(250, 218, 122, 0.42);
  box-shadow: 0 18rpx 46rpx rgba(91, 74, 58, 0.09);
}

.login-tabs {
  display: flex;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #FFF4DD;
  border: 1px solid rgba(250, 218, 122, 0.42);
}

.login-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #9A8B7A;
  font-size: 25rpx;
  font-weight: 800;
}

.login-tab.active {
  background: #9CAF88;
  color: #FFFDF6;
  box-shadow: 0 8rpx 18rpx rgba(127, 149, 109, 0.18);
}

.login-form {
  margin-top: 24rpx;
}

.login-form .field-label {
  margin-top: 18rpx;
  color: #7F6F60;
}

.login-input {
  height: 88rpx;
  margin-top: 10rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  background: #FFFDF6;
}

.login-row-action {
  margin-top: 18rpx;
  text-align: right;
  color: #7F956D;
  font-size: 25rpx;
  font-weight: 700;
}

.login-recover-hint {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #f7f3e9;
  color: #9A8B7A;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-submit {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin: 30rpx 0 0;
  padding: 0;
  font-size: 30rpx;
  box-shadow: 0 12rpx 24rpx rgba(127, 149, 109, 0.18);
}

.login-helper {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9A8B7A;
  font-size: 25rpx;
}

.login-helper-link {
  margin-left: 10rpx;
  color: #7F956D;
  font-weight: 800;
}

.bind-phone-panel {
  text-align: center;
  margin-top: 8rpx;
}

.bind-phone-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #7F956D;
  font-size: 23rpx;
  font-weight: 800;
  border: 1px solid rgba(156, 175, 136, 0.24);
}

.bind-phone-title {
  display: block;
  margin-top: 22rpx;
  font-size: 34rpx;
  color: #5B4A3A;
  font-weight: 900;
}

.bind-phone-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #9A8B7A;
}

.bind-user-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #FFF4DD;
  border: 1px solid rgba(250, 218, 122, 0.42);
}

.bind-user-name {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: #5B4A3A;
}

.bind-user-account {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A8B7A;
}
