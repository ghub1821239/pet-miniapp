<view class="simple-page">
  <view class="pet-head">
    <image wx:if="{{pet.avatarType === 'image'}}" class="pet-avatar" src="{{pet.avatarValue}}" mode="aspectFill"></image>
    <view wx:else class="pet-avatar fallback" style="background: {{pet.color}};">{{pet.avatarValue || pet.initial}}</view>
    <view>
      <text class="page-title">{{pet.name}}</text>
      <text class="page-sub">{{pet.breed}} · {{pet.gender}} · {{pet.ageText}}</text>
    </view>
  </view>

  <view class="info-list">
    <view><text>类别</text><text>{{pet.type}}</text></view>
    <view><text>生日</text><text>{{pet.birthday || '未填写'}}</text></view>
    <view><text>体重</text><text>{{pet.weight}}</text></view>
    <view><text>下次提醒</text><text>{{pet.nextReminder}}</text></view>
    <view><text>喜好</text><text>{{pet.likes || '未填写'}}</text></view>
    <view><text>性格</text><text>{{pet.personality || '未填写'}}</text></view>
    <view><text>备注</text><text>{{pet.note || '暂无'}}</text></view>
  </view>

  <button class="primary-action" bindtap="editPet">编辑档案</button>
</view>
