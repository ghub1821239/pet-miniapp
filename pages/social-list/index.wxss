.social-list-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #FCE7C8 0%, #FFFDF6 34%, #F5F8EE 100%);
}

.social-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: calc(env(safe-area-inset-top) + 104rpx);
  margin: -24rpx -24rpx 20rpx;
  padding: env(safe-area-inset-top) 24rpx 0;
  box-sizing: border-box;
  background: rgba(252, 231, 200, 0.96);
  backdrop-filter: saturate(150%) blur(10rpx);
  border-bottom: 1px solid rgba(250, 218, 122, 0.28);
}

.social-back,
.social-topbar-placeholder {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.social-back {
  font-size: 58rpx;
  color: #5B4A3A;
}

.social-title {
  font-size: 32rpx;
  color: #5B4A3A;
  font-weight: 800;
}

.social-card {
  position: relative;
  z-index: 1;
  padding-top: 10rpx;
}

.social-user-item,
.social-post-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid rgba(156, 175, 136, 0.14);
}

.social-user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #EEF5EA;
  flex-shrink: 0;
}

.social-user-main,
.social-post-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.social-user-name,
.social-post-title {
  display: block;
  font-size: 28rpx;
  color: #5B4A3A;
  font-weight: 800;
}

.social-user-meta,
.social-post-meta,
.social-post-summary {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9A8B7A;
}

.social-user-tags {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7F956D;
  line-height: 1.5;
}

.social-user-arrow {
  margin-left: 16rpx;
  color: #B2A696;
  font-size: 34rpx;
}

.social-post-cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 24rpx;
  background: #EEF5EA;
  flex-shrink: 0;
}

.social-post-summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
}
