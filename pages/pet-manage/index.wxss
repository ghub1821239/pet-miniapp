.simple-page {
  min-height: 100vh;
  padding: 34rpx 28rpx;
  background: #FFFDF6;
  color: #5B4A3A;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-start;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  display: block;
  margin-top: 10rpx;
  color: #9A8B7A;
  font-size: 24rpx;
  line-height: 1.5;
}

.text-action {
  flex-shrink: 0;
  margin: 4rpx 0 0;
  padding: 0 22rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #7F956D;
  font-size: 24rpx;
  font-weight: 800;
}

.text-action::after,
.primary-action::after {
  border: none;
}

.line-list {
  margin-top: 28rpx;
}

.pet-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid rgba(156, 175, 136, 0.18);
}

.pet-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #EEF5EA;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFDF6;
  font-weight: 800;
}

.pet-main {
  flex: 1;
  min-width: 0;
}

.pet-name {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
}

.pet-meta,
.pet-info,
.pet-reminder {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A8B7A;
}

.pet-reminder {
  color: #7F956D;
}

.row-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 16rpx;
  color: #7F956D;
  font-size: 25rpx;
  font-weight: 800;
}

.danger {
  color: #B56A53;
}

.empty-state {
  padding-top: 130rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin: 14rpx auto 28rpx;
  max-width: 480rpx;
  color: #9A8B7A;
  font-size: 25rpx;
  line-height: 1.6;
}

.primary-action {
  background: #9CAF88;
  color: #FFFDF6;
  border-radius: 999rpx;
  font-weight: 800;
}

.primary-action.small {
  display: inline-block;
  width: auto;
  padding: 0 44rpx;
}
