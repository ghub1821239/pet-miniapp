.identify-page {
  background: linear-gradient(180deg, #fbf7eb 0%, #fff8e7 24%, #f7f9f0 100%);
}

.identify-action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.identify-action-item {
  padding: 22rpx 16rpx;
  border-radius: 24rpx;
  text-align: center;
  background: linear-gradient(180deg, #fffef9 0%, #f8fbf3 100%);
  border: 1px solid #ece2cf;
}

.identify-action-icon {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #eef5ea;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.identify-action-title {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #5a4632;
}

.identify-action-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #9a8b7a;
}

.upload-box {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  background: #fbfbf3;
  border: 2rpx dashed #b1c29e;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-empty {
  text-align: center;
  color: #9f8d78;
}

.upload-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 14rpx;
}

.upload-text {
  font-size: 28rpx;
}

.identify-btn-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.identify-btn-row button {
  width: 48%;
}

.identify-confidence {
  font-size: 34rpx;
  font-weight: 700;
  color: #87996e;
}

.identify-demo-image {
  width: 100%;
  height: 320rpx;
  display: block;
  margin-top: 18rpx;
  border-radius: 24rpx;
}

.identify-result-head {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.identify-pet-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #eef5ea;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.identify-pet-copy {
  margin-left: 16rpx;
}

.identify-pet-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5a4632;
}

.identify-pet-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f7b67;
}

.identify-feature-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.identify-feature-tag {
  margin-top: 10rpx;
}

.identify-advice-box {
  margin-top: 20rpx;
}

.identify-result-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.identify-action-btn {
  margin-right: 14rpx;
  margin-top: 12rpx;
}

.identify-record-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid #efe5d4;
}

.identify-record-item:last-child {
  border-bottom: none;
}

.identify-record-image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.identify-record-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5a4632;
}

.identify-record-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8f7b67;
}

.identify-record-side {
  margin-left: 20rpx;
  text-align: right;
}

.identify-record-date {
  display: block;
  font-size: 22rpx;
  color: #9a8b7a;
}

.identify-record-action {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #87996e;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5a4632;
}

.empty-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9a8b7a;
  line-height: 1.7;
}
