.identify-page {
  background: #f5f5f5;
}

.identify-status-card {
  margin-top: -2rpx;
}

.identify-status-card.is-ready,
.identify-status-card.is-fallback {
  background: #ffffff;
}

.identify-status-head {
  display: flex;
  align-items: center;
}

.identify-status-mode {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #ffeef2;
  color: #b21b3b;
  font-size: 22rpx;
  font-weight: 700;
}

.identify-status-title {
  margin-left: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #1f1f1f;
}

.identify-status-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #767676;
}

.upload-box {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  background: #f4f4f4;
  border: 2rpx dashed #cfcfcf;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-empty {
  text-align: center;
  color: #7f7f7f;
}

.upload-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 14rpx;
}

.upload-text {
  font-size: 28rpx;
}

.identify-btn-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.identify-btn-row button {
  width: 48%;
}

.identify-demo-image {
  width: 100%;
  height: 320rpx;
  display: block;
  margin-top: 18rpx;
  border-radius: 24rpx;
}

.identify-core-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.identify-core-item {
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #fafafa;
  border: 1px solid #ececec;
}

.identify-core-label {
  display: block;
  font-size: 22rpx;
  color: #8b8b8b;
}

.identify-core-value {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 800;
  color: #1f1f1f;
}

.identify-feature-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.identify-feature-tag {
  margin-top: 10rpx;
}

.identify-advice-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff4f7;
  border: 1px solid #ffdbe3;
}

.identify-advice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #8e1d37;
}

.identify-advice-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5d4e53;
}

.identify-result-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.identify-action-btn {
  margin-right: 14rpx;
  margin-top: 12rpx;
}

.identify-record-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid #f1f1f1;
}

.identify-record-item:last-child {
  border-bottom: none;
}

.identify-record-image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.identify-record-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.identify-record-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #767676;
}

.identify-record-side {
  margin-left: 20rpx;
  text-align: right;
}

.identify-record-date {
  display: block;
  font-size: 22rpx;
  color: #8d8d8d;
}

.identify-record-updated {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a0a0a0;
}

.identify-record-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1px solid #ffd8e2;
  background: #fff3f6;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b21c3c;
  line-height: 1.2;
}

.identify-record-action.is-pending {
  border-color: #e60023;
  background: #ffe8ee;
  font-weight: 700;
}

.identify-archive-modal {
  max-height: calc(100vh - env(safe-area-inset-top) - 40rpx);
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  padding-top: 24rpx;
}

.identify-archive-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #757575;
}

.identify-archive-preview {
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  margin-top: 18rpx;
  background: #f2f2f2;
}

.identify-archive-notes {
  min-height: 160rpx;
  line-height: 1.6;
}

.identify-archive-actions {
  display: flex;
  margin-top: 24rpx;
  padding-top: 16rpx;
  padding-bottom: 6rpx;
  border-top: 1px solid #f0f0f0;
  position: sticky;
  bottom: 0;
  background: #fff;
  z-index: 3;
}

.identify-archive-btn {
  flex: 1;
}

.identify-archive-btn + .identify-archive-btn {
  margin-left: 16rpx;
}

.identify-archive-modal .input,
.identify-archive-modal .picker-box {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.identify-archive-modal .textarea {
  font-size: 27rpx;
}

.identify-page .mask {
  z-index: 1201;
}
