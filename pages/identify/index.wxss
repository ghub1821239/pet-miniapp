.upload-box {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  background: #fff8ee;
  border: 2rpx dashed #e5c974;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-empty {
  text-align: center;
  color: #a59582;
}

.upload-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 14rpx;
}

.upload-text {
  font-size: 28rpx;
}

.identify-btn-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.identify-btn-row button {
  width: 48%;
}
