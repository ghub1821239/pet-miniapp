page,
.identify-page {
  background: #FFFDF6;
}

.identify-compact-head {
  margin: 0 0 18rpx;
  padding: 22rpx 24rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 253, 246, 0.76);
  box-shadow: 0 10rpx 28rpx rgba(91, 74, 58, 0.06);
}

.identify-compact-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.identify-compact-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.identify-compact-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #6F8D58;
  font-size: 22rpx;
  font-weight: 700;
}

.identify-compact-status.is-fallback {
  background: #FFF4EA;
  color: #B56A53;
}

.identify-compact-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #9CAF88;
}

.identify-compact-status.is-fallback .identify-compact-dot {
  background: #D8B36A;
}

.identify-compact-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #7F7163;
}

.upload-box {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  background: #EEF5EA;
  border: 2rpx dashed #cfcfcf;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-empty {
  text-align: center;
  color: #9A8B7A;
}

.upload-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 14rpx;
}

.upload-text {
  font-size: 28rpx;
}

.identify-btn-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.identify-btn-row button {
  width: 48%;
}

.identify-demo-image {
  width: 100%;
  height: 320rpx;
  display: block;
  margin-top: 18rpx;
  border-radius: 24rpx;
}

.identify-core-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.identify-core-item {
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #fafafa;
  border: 1px solid rgba(250, 218, 122, 0.35);
}

.identify-core-label {
  display: block;
  font-size: 22rpx;
  color: #8b8b8b;
}

.identify-core-value {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 800;
  color: #5B4A3A;
}

.identify-feature-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.identify-feature-tag {
  margin-top: 10rpx;
}

.identify-advice-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFF4D1;
  border: 1px solid #ffdbe3;
}

.identify-advice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #8e1d37;
}

.identify-advice-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5d4e53;
}

.identify-source-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.identify-source-badge.is-api {
  color: #6f8d58;
  background: rgba(155, 181, 138, 0.18);
}

.identify-source-badge.is-demo {
  color: #b0765f;
  background: rgba(250, 218, 122, 0.24);
}

.identify-result-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.identify-action-btn {
  margin-right: 14rpx;
  margin-top: 12rpx;
}

.identify-record-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid #FFF8E5;
}

.identify-record-item:last-child {
  border-bottom: none;
}

.identify-record-image {
  width: 86rpx;
  height: 86rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.identify-record-main {
  flex: 1;
  min-width: 0;
}

.identify-record-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5B4A3A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.identify-record-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9A8B7A;
  line-height: 1.35;
}

.identify-record-side {
  width: 268rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  text-align: right;
}

.identify-record-date {
  display: block;
  font-size: 22rpx;
  color: #9A8B7A;
}

.identify-record-updated {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a0a0a0;
}

.identify-record-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  margin-top: 8rpx;
}

.identify-record-action,
.identify-record-delete {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  box-sizing: border-box;
  padding: 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.identify-record-action {
  width: 152rpx;
  border: 1px solid #ffd8e2;
  background: #FFF4D1;
  color: #b21c3c;
}

.identify-record-delete {
  width: 82rpx;
  margin: 0;
  background: #FFF4EA;
  color: #B56A53;
}

.identify-record-delete::after {
  border: none;
}

.identify-record-action.is-pending {
  border-color: #9CAF88;
  background: #EEF5EA;
  font-weight: 700;
}

.identify-result-page {
  align-items: stretch;
  background: #FFFDF6;
}

.identify-archive-modal {
  width: 100%;
  height: 100vh;
  max-height: none;
  border-radius: 0;
  border-top: none;
  padding: calc(env(safe-area-inset-top) + 72rpx) 24rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #FFFDF6;
}

.identify-archive-modal .modal-title {
  display: block;
  padding-right: 190rpx;
  font-size: 38rpx;
  line-height: 1.2;
}

.identify-archive-sub {
  display: block;
  margin-top: 12rpx;
  padding-right: 190rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #9A8B7A;
}

.identify-archive-preview {
  width: 100%;
  height: 330rpx;
  border-radius: 22rpx;
  margin-top: 20rpx;
  background: #EEF5EA;
}

.identify-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.identify-summary-item {
  padding: 16rpx 10rpx;
  border-radius: 18rpx;
  background: #F3F7EF;
  text-align: center;
}

.identify-summary-label {
  display: block;
  font-size: 21rpx;
  color: #9A8B7A;
}

.identify-summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: #5B4A3A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.identify-info-section,
.identify-save-guide {
  margin-top: 28rpx;
}

.identify-info-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.identify-info-list {
  margin-top: 12rpx;
  border-top: 1px solid rgba(218, 198, 162, 0.35);
}

.identify-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  border-bottom: 1px solid rgba(218, 198, 162, 0.28);
}

.identify-info-label {
  flex-shrink: 0;
  font-size: 25rpx;
  color: #9A8B7A;
}

.identify-info-value {
  margin-left: 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5B4A3A;
  text-align: right;
}

.identify-care-block {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FFF9E8;
}

.identify-care-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 27rpx;
  font-weight: 800;
  color: #6F8D58;
}

.identify-bullet,
.identify-note-item {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #7F7163;
}

.identify-note-list {
  margin-top: 10rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #F6F1E7;
}

.identify-guide-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #7F7163;
}

.identify-archive-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 16rpx;
  padding-bottom: calc(6rpx + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(250, 218, 122, 0.32);
  position: sticky;
  bottom: 0;
  background: #FFFDF6;
  z-index: 3;
}

.identify-archive-btn {
  flex: 1;
}

.identify-page .mask {
  z-index: 1201;
}
