.simple-page {
  min-height: 100vh;
  padding: 34rpx 28rpx;
  box-sizing: border-box;
  background: #FFFDF6;
  color: #5B4A3A;
}

.page-head {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-start;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  display: block;
  margin-top: 10rpx;
  color: #9A8B7A;
  font-size: 24rpx;
  line-height: 1.5;
}

.text-action {
  flex-shrink: 0;
  margin: 4rpx 0 0;
  padding: 0 22rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #7F956D;
  font-size: 24rpx;
  font-weight: 800;
}

.text-action::after {
  border: none;
}

.filter-tabs {
  display: flex;
  gap: 34rpx;
  margin-top: 34rpx;
  padding-bottom: 18rpx;
  border-bottom: 1px solid rgba(156, 175, 136, 0.18);
}

.filter-tab {
  color: #9A8B7A;
  font-weight: 800;
}

.filter-tab.active {
  color: #7F956D;
}

.station-alert {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #FFF4EA;
  color: #B56A53;
  font-size: 24rpx;
}

.reminder-row {
  padding: 26rpx 0;
  border-bottom: 1px solid rgba(156, 175, 136, 0.18);
}

.item-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
}

.item-meta,
.item-note,
.item-fail {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A8B7A;
}

.item-fail {
  color: #B56A53;
}

.row-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 16rpx;
  color: #7F956D;
  font-weight: 800;
}

.empty-state {
  padding-top: 130rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  color: #9A8B7A;
}
