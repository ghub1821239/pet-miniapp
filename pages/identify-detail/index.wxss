.simple-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #FFFDF6;
  color: #5B4A3A;
}

.hero-image {
  width: 100%;
  height: 430rpx;
  border-radius: 28rpx;
  background: #EEF5EA;
}

.page-head {
  margin-top: 28rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  display: block;
  margin-top: 10rpx;
  color: #9A8B7A;
}

.info-list {
  margin-top: 26rpx;
  background: rgba(238, 245, 234, 0.34);
  border-radius: 28rpx;
  padding: 0 22rpx;
}

.info-list view {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid rgba(156, 175, 136, 0.18);
}

.info-list view:last-child {
  border-bottom: none;
}

.info-list text:first-child {
  color: #7F6F5E;
  font-weight: 800;
}

.info-list text:last-child {
  flex: 1;
  text-align: right;
}

.action-list {
  margin-top: 34rpx;
}

.primary-action,
.secondary-action {
  margin-top: 18rpx;
  border-radius: 999rpx;
  font-weight: 800;
}

.primary-action {
  background: #9CAF88;
  color: #FFFDF6;
}

.secondary-action {
  background: #EEF5EA;
  color: #7F956D;
}

.primary-action::after,
.secondary-action::after {
  border: none;
}
