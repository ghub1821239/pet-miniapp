.consult-page {
  background: #f5f5f5;
}

.consult-toolbar {
  margin-bottom: 16rpx;
}

.search-row {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1px solid #e5e5e5;
  font-size: 24rpx;
  color: #1f1f1f;
}

.search-btn {
  margin-left: 14rpx;
  min-width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e60023;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.filter-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.filter-pill,
.filter-refresh,
.filter-permission {
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.filter-pill {
  margin-right: 12rpx;
  background: #f3f3f3;
  color: #4a4a4a;
  border: 1px solid #e8e8e8;
}

.filter-refresh {
  margin-left: auto;
  background: #ffffff;
  color: #2f2f2f;
  border: 1px solid #dddddd;
}

.filter-permission {
  margin-left: 12rpx;
  background: #ffe8ee;
  color: #b31739;
  border: 1px solid #ffd0dc;
}

.toolbar-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #8a8a8a;
  line-height: 1.6;
}

.map-card {
  padding: 22rpx;
  position: relative;
  overflow: hidden;
  background: #ffffff;
}

.map-card::before {
  content: '';
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 14rpx;
  bottom: 14rpx;
  border: 2rpx dashed rgba(230, 0, 35, 0.22);
  border-radius: 26rpx;
  pointer-events: none;
}

.map-head {
  margin-bottom: 14rpx;
  position: relative;
  z-index: 3;
}

.map-title {
  margin: 0;
}

.map-range-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #5e5e5e;
  background: #f4f4f4;
  border: 1px solid #ececec;
}

.map-shell {
  position: relative;
  z-index: 2;
}

.consult-map {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1px solid #ebebeb;
}

.map-decor {
  position: absolute;
  z-index: 2;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 24rpx;
  color: #666;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid #ececec;
}

.map-decor-left {
  left: 16rpx;
  top: 16rpx;
  transform: rotate(-8deg);
}

.map-decor-right {
  right: 16rpx;
  top: 16rpx;
  transform: rotate(10deg);
}

.map-hint-card {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1px solid #ececec;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 2;
}

.map-hint-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1f1f1f;
}

.map-hint-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #767676;
}

.map-hint-actions {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.map-hint-btn {
  margin-right: 10rpx;
}

.map-error-row {
  margin-top: 14rpx;
}

.map-retry-btn {
  width: 220rpx;
}

.hospital-list-card {
  margin-bottom: 0;
}

.hospital-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.hospital-item:last-child {
  border-bottom: none;
}

.hospital-item.is-active .hospital-name {
  color: #c3173a;
}

.hospital-main {
  flex: 1;
  min-width: 0;
}

.hospital-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1f1f1f;
}

.hospital-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6f6f6f;
}

.hospital-status {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.hospital-address {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a8a8a;
  line-height: 1.6;
}

.hospital-side {
  margin-left: 16rpx;
}

.hospital-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ffeef2;
  color: #a62542;
  font-size: 20rpx;
  border: 1px solid #ffd7e0;
}

.consult-empty {
  padding: 48rpx 12rpx 18rpx;
}

.empty-reset-btn {
  margin-top: 22rpx;
}
