.search-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 104rpx) 24rpx 44rpx;
  background: #FCE7C8;
  color: #5B4A3A;
}

.search-topbar {
  display: flex;
  align-items: center;
  margin: 0 -4rpx 22rpx;
}

.search-exit {
  width: 62rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5B4A3A;
  flex-shrink: 0;
}

.search-back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #5B4A3A;
  border-bottom: 5rpx solid #5B4A3A;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input-wrap {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.45);
  box-shadow: 0 8rpx 18rpx rgba(91, 74, 58, 0.06);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.search-icon {
  color: #9A8B7A;
  font-size: 34rpx;
  margin-right: 10rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: #5B4A3A;
  font-size: 26rpx;
}

.search-clear {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(250, 218, 122, 0.35);
  color: #9A8B7A;
  font-size: 32rpx;
  line-height: 38rpx;
  text-align: center;
  flex-shrink: 0;
}

.search-submit {
  width: 86rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #9CAF88;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.search-section {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.45);
  box-shadow: 0 8rpx 20rpx rgba(91, 74, 58, 0.06);
}

.search-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.search-section-title {
  color: #5B4A3A;
  font-size: 30rpx;
  font-weight: 800;
}

.search-section-sub,
.search-section-action {
  color: #9A8B7A;
  font-size: 22rpx;
}

.search-chip-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: -8rpx;
}

.search-chip {
  margin: 12rpx 12rpx 0 0;
  padding: 13rpx 22rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #5B4A3A;
  font-size: 24rpx;
  line-height: 1.2;
  border: 1px solid rgba(250, 218, 122, 0.35);
}

.search-chip.guess {
  background: #EEF5EA;
  color: #7F956D;
  border-color: #FADA7A;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1px solid rgba(250, 218, 122, 0.32);
}

.hot-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: rgba(250, 218, 122, 0.32);
  color: #9A8B7A;
  font-size: 22rpx;
  line-height: 44rpx;
  text-align: center;
  font-weight: 700;
  flex-shrink: 0;
}

.hot-rank.top {
  background: #EEF5EA;
  color: #7F956D;
}

.hot-keyword {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  color: #5B4A3A;
  font-size: 27rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hot-heat {
  color: #9A8B7A;
  font-size: 22rpx;
  margin-left: 16rpx;
}

.search-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.45);
}

.search-result-title {
  flex: 1;
  min-width: 0;
  color: #5B4A3A;
  font-size: 28rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-result-count {
  color: #9A8B7A;
  font-size: 22rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.search-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.search-column {
  width: 48%;
}

.feed-card {
  background: #FFFDF6;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 1px solid rgba(250, 218, 122, 0.45);
  box-shadow: 0 10rpx 22rpx rgba(91, 74, 58, 0.06);
}

.feed-cover {
  width: 100%;
  display: block;
  background: #EEF5EA;
}

.feed-body {
  padding: 18rpx 18rpx 20rpx;
}

.feed-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  color: #5B4A3A;
  font-weight: 700;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 84rpx;
}

.feed-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.feed-user {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.feed-avatar-image,
.feed-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 253, 246, 0.95);
  box-sizing: border-box;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.feed-avatar-image {
  display: block;
  background: #FFF8E5;
}

.feed-avatar {
  background: #FFF8E5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.feed-user-name {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: #5B4A3A;
  font-weight: 500;
}

.feed-like {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  column-gap: 6rpx;
  color: #9A8B7A;
  font-size: 22rpx;
}

.feed-like.active {
  color: #9CAF88;
}

.feed-like-icon {
  font-size: 24rpx;
  line-height: 1;
}

.search-empty {
  margin-top: 120rpx;
  text-align: center;
  color: #9A8B7A;
}

.search-empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.search-empty-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
}
