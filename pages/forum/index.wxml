<view class="page-container community-page">
  <view class="community-header">
    <view>
      <text class="community-title">萌宠广场</text>
    </view>
    <view class="community-header-actions">
      <view class="community-search" bindtap="openSearch">搜索宠物、话题、同城玩伴</view>
      <view class="community-top-plus" bindtap="goPublish">+</view>
    </view>
  </view>

  <scroll-view class="channel-scroll" scroll-x enable-flex show-scrollbar="false">
    <view class="channel-list">
      <block wx:for="{{channels}}" wx:key="*this">
        <view
          class="channel-item {{activeChannel === item ? 'active' : ''}}"
          data-channel="{{item}}"
          bindtap="switchChannel"
        >
          {{item}}
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="community-grid">
    <view class="community-column">
      <block wx:for="{{leftColumn}}" wx:key="id">
        <view class="feed-card">
          <view class="feed-cover-wrap">
            <image wx:if="{{item.coverImage}}" class="feed-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view wx:else class="feed-cover feed-cover-placeholder {{'tone-' + item.coverTone}}">
              <text class="feed-cover-emoji">{{item.coverEmoji}}</text>
              <text class="feed-cover-label">{{item.petName}}</text>
            </view>
            <view wx:if="{{item.mediaType === 'video'}}" class="feed-video-badge">视频</view>
          </view>

          <view class="feed-body">
            <text class="feed-title">{{item.title}}</text>

            <view class="feed-tags">
              <block wx:for="{{item.tags}}" wx:key="*this">
                <text class="feed-tag">{{item}}</text>
              </block>
            </view>

            <view class="feed-pet-card">
              <text class="feed-pet-name">{{item.petName}}</text>
              <text class="feed-pet-meta">{{item.breed}} {{item.petCard.age}}</text>
              <text class="feed-pet-meta">{{item.petCard.personality}}｜{{item.petCard.activity}}</text>
            </view>

            <view class="feed-footer">
              <view class="feed-user">
                <view class="feed-avatar">{{item.avatar}}</view>
                <view class="feed-user-copy">
                  <text class="feed-user-name">{{item.userName}}</text>
                  <text class="feed-user-location">{{item.city}}｜{{item.distance}}</text>
                </view>
              </view>

              <view class="feed-like {{item.liked ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleLike">
                ❤ {{item.likeCount}}
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="community-column">
      <block wx:for="{{rightColumn}}" wx:key="id">
        <view class="feed-card">
          <view class="feed-cover-wrap">
            <image wx:if="{{item.coverImage}}" class="feed-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view wx:else class="feed-cover feed-cover-placeholder {{'tone-' + item.coverTone}}">
              <text class="feed-cover-emoji">{{item.coverEmoji}}</text>
              <text class="feed-cover-label">{{item.petName}}</text>
            </view>
            <view wx:if="{{item.mediaType === 'video'}}" class="feed-video-badge">视频</view>
          </view>

          <view class="feed-body">
            <text class="feed-title">{{item.title}}</text>

            <view class="feed-tags">
              <block wx:for="{{item.tags}}" wx:key="*this">
                <text class="feed-tag">{{item}}</text>
              </block>
            </view>

            <view class="feed-pet-card">
              <text class="feed-pet-name">{{item.petName}}</text>
              <text class="feed-pet-meta">{{item.breed}} {{item.petCard.age}}</text>
              <text class="feed-pet-meta">{{item.petCard.personality}}｜{{item.petCard.activity}}</text>
            </view>

            <view class="feed-footer">
              <view class="feed-user">
                <view class="feed-avatar">{{item.avatar}}</view>
                <view class="feed-user-copy">
                  <text class="feed-user-name">{{item.userName}}</text>
                  <text class="feed-user-location">{{item.city}}｜{{item.distance}}</text>
                </view>
              </view>

              <view class="feed-like {{item.liked ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleLike">
                ❤ {{item.likeCount}}
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{filteredPosts.length === 0}}" class="card community-empty">
    <text class="section-title">这个频道还很安静</text>
    <text class="section-sub">先发一条你家萌宠的动态吧。</text>
  </view>

  <view class="community-fab" bindtap="goPublish">
    <text class="community-fab-icon">+</text>
  </view>

  <pet-tabbar current="community"></pet-tabbar>
</view>
