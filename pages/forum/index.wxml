<view class="page-container community-page">
  <view class="page-topbar">
    <view class="page-topbar-inner">
      <view class="brand-lockup">
        <view class="brand-dot"></view>
        <text class="brand-text">Pet Pins</text>
      </view>
      <view class="brand-cta">发布</view>
    </view>
  </view>

  <view class="community-search-section">
    <view class="community-search-row">
      <view class="community-search header-search" bindtap="openSearch">
        <text class="community-search-icon">⌕</text>
        <text class="community-search-placeholder">搜索宠物、话题、周边玩伴</text>
      </view>
    </view>
    <view class="search-tip-row">
      <text class="search-tip">灵感来自真实宠物社区，按兴趣持续刷新</text>
    </view>
  </view>

  <view class="smart-nav-row">
    <view class="filter-entry" bindtap="toggleFilterPanel">
      <view class="filter-line"></view>
      <view class="filter-line short"></view>
      <view class="filter-line tiny"></view>
    </view>

    <view class="smart-channel-list">
      <block wx:for="{{channels}}" wx:key="*this">
        <view
          class="smart-channel {{activeChannel === item ? 'active' : ''}}"
          data-channel="{{item}}"
          bindtap="handleChannelChange"
        >
          {{item}}
        </view>
      </block>
    </view>
  </view>

  <swiper class="community-banner-swiper" autoplay interval="3500" circular indicator-dots indicator-color="rgba(0,0,0,0.18)" indicator-active-color="#e60023">
    <block wx:for="{{banners}}" wx:key="id">
      <swiper-item>
        <view class="community-banner-card">
          <image class="community-banner-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="community-banner-mask">
            <text class="community-banner-title">{{item.title}}</text>
            <text class="community-banner-sub">{{item.subtitle}}</text>
          </view>
        </view>
      </swiper-item>
    </block>
  </swiper>

  <view class="feed-meta-row">
    <view class="feed-meta-main">
      <text class="feed-meta-title">{{feedTitle}}</text>
      <text class="feed-meta-sub">{{filteredPosts.length}} 条内容</text>
    </view>
    <view class="feed-meta-tags" wx:if="{{activeFilterSummary.length}}">
      <block wx:for="{{activeFilterSummary}}" wx:key="*this">
        <text class="feed-meta-tag">{{item}}</text>
      </block>
    </view>
  </view>

  <template name="communityFeedCard">
    <view class="feed-card feed-card-{{item.postDisplayType}}" bindtap="handlePostTap" data-id="{{item.id}}">
      <block wx:if="{{item.postDisplayType === 'share'}}">
        <view class="feed-cover-wrap">
          <image class="feed-cover" src="{{item.coverImage}}" mode="widthFix"></image>
          <view class="cover-corner">
            <text class="cover-corner-text">{{item.statusBadge}}</text>
          </view>
        </view>

        <view class="feed-body">
          <view class="card-chip-row">
            <block wx:for="{{item.quickTags}}" wx:key="*this" wx:for-item="tag">
              <text class="card-chip">{{tag}}</text>
            </block>
          </view>
          <text class="feed-title share-title">{{item.title}}</text>

          <view class="feed-footer">
            <view class="feed-user share-user">
              <image class="feed-avatar-image" src="{{item.avatarImage}}" mode="aspectFill"></image>
              <view class="feed-user-copy">
                <text class="feed-user-name">{{item.userName}}</text>
              </view>
            </view>
            <view class="feed-like share-like {{item.liked ? 'active' : ''}}" data-id="{{item.id}}" catchtap="handleLike">
              <text class="feed-like-icon">❤</text>
              <text>{{item.likeCount}}</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:elif="{{item.postDisplayType === 'qa'}}">
        <view class="feed-body qa-body">
          <view class="status-row">
            <text class="status-badge status-{{item.statusTone}}">{{item.statusBadge}}</text>
            <text class="status-meta">{{item.statusMeta}}</text>
          </view>
          <text class="feed-title qa-title">{{item.title}}</text>
          <text class="qa-summary">{{item.summaryText}}</text>
          <view class="card-chip-row">
            <block wx:for="{{item.quickTags}}" wx:key="*this" wx:for-item="tag">
              <text class="card-chip card-chip-qa">{{tag}}</text>
            </block>
          </view>
          <view class="feed-footer qa-footer">
            <view class="feed-user">
              <image class="feed-avatar-image" src="{{item.avatarImage}}" mode="aspectFill"></image>
              <view class="feed-user-copy">
                <text class="feed-user-name">{{item.userName}}</text>
              </view>
            </view>
            <view class="feed-like {{item.liked ? 'active' : ''}}" data-id="{{item.id}}" catchtap="handleLike">
              <text class="feed-like-icon">❤</text>
              <text>{{item.likeCount}}</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="feed-body help-body">
          <view class="status-row">
            <text class="status-badge status-{{item.statusTone}}">{{item.statusBadge}}</text>
            <text class="status-meta">{{item.statusMeta}}</text>
          </view>
          <text class="feed-title help-title">{{item.title}}</text>
          <text class="help-summary">{{item.summaryText}}</text>
          <view class="card-chip-row">
            <block wx:for="{{item.quickTags}}" wx:key="*this" wx:for-item="tag">
              <text class="card-chip card-chip-help">{{tag}}</text>
            </block>
          </view>
          <view class="feed-footer help-footer">
            <view class="feed-user">
              <image class="feed-avatar-image" src="{{item.avatarImage}}" mode="aspectFill"></image>
              <view class="feed-user-copy">
                <text class="feed-user-name">{{item.userName}}</text>
              </view>
            </view>
            <view class="feed-like {{item.liked ? 'active' : ''}}" data-id="{{item.id}}" catchtap="handleLike">
              <text class="feed-like-icon">❤</text>
              <text>{{item.likeCount}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </template>

  <view class="community-grid">
    <view class="community-column">
      <block wx:for="{{leftColumn}}" wx:key="id">
        <template is="communityFeedCard" data="{{item:item}}"></template>
      </block>
    </view>

    <view class="community-column">
      <block wx:for="{{rightColumn}}" wx:key="id">
        <template is="communityFeedCard" data="{{item:item}}"></template>
      </block>
    </view>
  </view>

  <view wx:if="{{filteredPosts.length === 0}}" class="card community-empty">
    <text class="section-title">没有符合条件的动态</text>
    <text class="section-sub">换一个主题或筛选条件试试</text>
  </view>

  <view wx:if="{{filterPanelVisible}}" class="filter-mask" bindtap="closeFilterPanel"></view>
  <view class="filter-drawer {{filterPanelVisible ? 'show' : ''}}">
    <scroll-view scroll-y class="filter-drawer-scroll">
      <text class="drawer-title">分区</text>

      <block wx:for="{{filterOptions}}" wx:key="value">
        <view
          class="drawer-filter-row {{item.active ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleDrawerCategoryTap"
        >
          <text class="drawer-filter-name">{{item.label}}</text>
        </view>
      </block>

      <view class="drawer-reset" bindtap="resetFilters">重置</view>
    </scroll-view>
  </view>

  <view class="community-fab" bindtap="handlePublish">
    <text class="community-fab-icon">+</text>
  </view>

  <pet-tabbar current="community"></pet-tabbar>
</view>
