<view class="page-container">
  <view class="hero">
    <text class="hero-title">萌宠论坛</text>
    <text class="hero-sub">支持图文、定位、评论互动，当前为 1.0 原型版，后续可以扩展帖子详情、点赞排行、分区筛选等。</text>
  </view>

  <view class="card">
    <text class="section-title">发布动态</text>

    <text class="field-label">内容分区</text>
    <picker range="{{sections}}" value="{{sectionIndex}}" bindchange="changeSection">
      <view class="picker-box">当前分区：{{sections[sectionIndex]}}</view>
    </picker>

    <text class="field-label">帖子内容</text>
    <textarea
      class="textarea"
      placeholder="分享你和宠物的日常、安利好物，或者发起交友～"
      value="{{form.content}}"
      bindinput="bindPostContent"
    ></textarea>

    <view class="forum-btn-row">
      <button class="secondary-btn" bindtap="choosePostImages">添加图片</button>
      <button class="secondary-btn" bindtap="chooseLocation">添加定位</button>
    </view>

    <view wx:if="{{form.locationName}}" class="tag">📍 {{form.locationName}}</view>

    <view wx:if="{{form.images.length > 0}}" class="forum-image-list">
      <block wx:for="{{form.images}}" wx:key="*this">
        <image class="forum-thumb" src="{{item}}" mode="aspectFill"></image>
      </block>
    </view>

    <button class="primary-btn forum-submit" bindtap="submitPost">发布帖子</button>
  </view>

  <text class="section-title">最新动态</text>

  <block wx:for="{{posts}}" wx:key="id">
    <view class="card">
      <view class="forum-head">
        <view class="forum-user">
          <view class="forum-avatar">{{item.avatar}}</view>
          <view>
            <text class="forum-user-name">{{item.user}}</text>
            <text class="forum-time">{{item.createdAt}}</text>
          </view>
        </view>
        <text class="tag">{{item.section}}</text>
      </view>

      <view class="forum-content">{{item.content}}</view>

      <view wx:if="{{item.locationName}}" class="tag">📍 {{item.locationName}}</view>

      <view wx:if="{{item.images.length > 0}}" class="forum-image-list">
        <block wx:for="{{item.images}}" wx:key="*this">
          <image class="forum-thumb" src="{{item}}" mode="aspectFill"></image>
        </block>
      </view>

      <view class="forum-action-row">
        <button class="small-btn" data-index="{{index}}" bindtap="toggleLike">
          {{item.liked ? '已点赞' : '点赞'}} {{item.likeCount}}
        </button>
      </view>

      <view class="forum-comment-box">
        <block wx:if="{{item.comments.length > 0}}">
          <block wx:for="{{item.comments}}" wx:key="id">
            <view class="forum-comment-line">
              <text class="forum-comment-user">{{item.user}}：</text>
              <text>{{item.text}}</text>
            </view>
          </block>
        </block>

        <input
          class="input"
          placeholder="写下你的评论..."
          value="{{item.commentDraft}}"
          data-index="{{index}}"
          bindinput="inputComment"
        />
        <view class="forum-comment-btn-wrap">
          <button class="secondary-btn" data-index="{{index}}" bindtap="addComment">发表评论</button>
        </view>
      </view>
    </view>
  </block>

  <pet-tabbar current="forum"></pet-tabbar>
</view>