<view class="page-container community-page">
  <view class="page-topbar">
    <view class="page-topbar-inner">
    </view>
  </view>

  <view class="community-search-section">
    <view class="community-search-row">
      <view class="community-search header-search" bindtap="openSearch">
        <text class="community-search-icon">⌕</text>
        <text class="community-search-placeholder">搜索宠物、话题、周边玩伴</text>
      </view>
    </view>
  </view>

  <view class="smart-nav-row">
    <view class="filter-entry" bindtap="toggleFilterPanel">
      <view class="filter-line"></view>
      <view class="filter-line short"></view>
      <view class="filter-line tiny"></view>
    </view>

    <view class="smart-channel-list">
      <block wx:for="{{channels}}" wx:key="*this">
        <view
          class="smart-channel {{activeChannel === item ? 'active' : ''}}"
          data-channel="{{item}}"
          bindtap="handleChannelChange"
        >
          {{item}}
        </view>
      </block>
    </view>
  </view>

  <swiper class="community-banner-swiper" autoplay interval="3500" circular indicator-dots indicator-color="rgba(255,255,255,0.55)" indicator-active-color="#ffffff">
    <block wx:for="{{banners}}" wx:key="id">
      <swiper-item>
        <view class="community-banner-card">
          <image class="community-banner-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="community-banner-mask">
            <text class="community-banner-title">{{item.title}}</text>
            <text class="community-banner-sub">{{item.subtitle}}</text>
          </view>
        </view>
      </swiper-item>
    </block>
  </swiper>

  <view class="community-grid">
    <view class="community-column">
      <block wx:for="{{leftColumn}}" wx:key="id">
        <view class="feed-card" bindtap="handlePostTap" data-id="{{item.id}}">
          <view class="feed-cover-wrap">
            <image class="feed-cover" src="{{item.coverImage}}" mode="widthFix"></image>
          </view>

          <view class="feed-body">
            <text class="feed-title">{{item.title}}</text>

            <view class="feed-footer">
              <view class="feed-user">
                <image class="feed-avatar-image" src="{{item.avatarImage}}" mode="aspectFill"></image>
                <view class="feed-user-copy">
                  <text class="feed-user-name">{{item.userName}}</text>
                </view>
              </view>

              <view class="feed-like {{item.liked ? 'active' : ''}}" data-id="{{item.id}}" catchtap="handleLike">
                <text class="feed-like-icon">❤</text>
                <text>{{item.likeCount}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="community-column">
      <block wx:for="{{rightColumn}}" wx:key="id">
        <view class="feed-card" bindtap="handlePostTap" data-id="{{item.id}}">
          <view class="feed-cover-wrap">
            <image class="feed-cover" src="{{item.coverImage}}" mode="widthFix"></image>
          </view>

          <view class="feed-body">
            <text class="feed-title">{{item.title}}</text>

            <view class="feed-footer">
              <view class="feed-user">
                <image class="feed-avatar-image" src="{{item.avatarImage}}" mode="aspectFill"></image>
                <view class="feed-user-copy">
                  <text class="feed-user-name">{{item.userName}}</text>
                </view>
              </view>

              <view class="feed-like {{item.liked ? 'active' : ''}}" data-id="{{item.id}}" catchtap="handleLike">
                <text class="feed-like-icon">❤</text>
                <text>{{item.likeCount}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{filteredPosts.length === 0}}" class="card community-empty">
    <text class="section-title">没有符合条件的动态</text>
    <text class="section-sub">换一个主题或筛选条件试试</text>
  </view>

  <view wx:if="{{filterPanelVisible}}" class="filter-mask" bindtap="closeFilterPanel"></view>
  <view class="filter-drawer {{filterPanelVisible ? 'show' : ''}}">
    <scroll-view scroll-y class="filter-drawer-scroll">
      <text class="drawer-title">分区</text>

      <block wx:for="{{filterOptions}}" wx:key="value">
        <view
          class="drawer-filter-row {{item.active ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleDrawerCategoryTap"
        >
          <text class="drawer-filter-name">{{item.label}}</text>
        </view>
      </block>

      <view class="drawer-reset" bindtap="resetFilters">重置</view>
    </scroll-view>
  </view>

  <view class="community-fab" bindtap="handlePublish">
    <text class="community-fab-icon">+</text>
  </view>

  <pet-tabbar current="community"></pet-tabbar>
</view>
