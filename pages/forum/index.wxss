.community-page {
  background: linear-gradient(180deg, #fbf7eb 0%, #fff8e7 20%, #f7f9f0 100%);
}

.community-search-section {
  margin: 0 -24rpx;
  padding: 14rpx 28rpx 18rpx;
  background: #fff8e7;
}

.community-search-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.community-search {
  flex: 1;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 246, 0.98);
  border: 1px solid #ece2cf;
  color: #ad9777;
  font-size: 24rpx;
}

.header-search {
  margin-right: 16rpx;
}

.community-top-plus {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #a8c08a, #92ab75);
  color: #fffef8;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
  box-shadow: 0 10rpx 20rpx rgba(146, 168, 114, 0.2);
}

.community-top-search {
  font-size: 36rpx;
  position: relative;
  top: -2rpx;
}

.community-banner-swiper {
  height: 300rpx;
  margin-top: 18rpx;
}

.community-banner-card {
  position: relative;
  height: 280rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 32rpx rgba(191, 180, 150, 0.14);
}

.community-banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.community-banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 24rpx 22rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(70, 53, 39, 0.46) 100%);
}

.community-banner-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fffef8;
}

.community-banner-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 253, 246, 0.92);
}

.channel-scroll {
  width: 100%;
  margin-top: 24rpx;
  margin-bottom: 20rpx;
}

.channel-list {
  display: inline-flex;
  padding-right: 24rpx;
}

.channel-item {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 245, 0.96);
  color: #968572;
  font-size: 24rpx;
  margin-right: 16rpx;
  border: 1px solid #ede2ce;
}

.channel-item.active {
  background: linear-gradient(180deg, #f1f5e7, #e5edd7);
  color: #83946a;
  border-color: #d9e2c7;
  box-shadow: 0 10rpx 20rpx rgba(157, 175, 126, 0.16);
}

.community-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.community-column {
  width: 48%;
}

.feed-card {
  background: rgba(255, 255, 252, 0.98);
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 1px solid #f1e6d5;
  box-shadow: 0 10rpx 24rpx rgba(191, 180, 150, 0.1);
}

.feed-cover-wrap {
  position: relative;
}

.feed-cover {
  width: 100%;
  display: block;
  background: #f7f2e5;
}

.feed-cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.feed-cover-placeholder.tone-gold {
  background: linear-gradient(180deg, #fff2c7, #fff8e5);
}

.feed-cover-placeholder.tone-cream {
  background: linear-gradient(180deg, #fff9e7, #fffef6);
}

.feed-cover-placeholder.tone-soft {
  background: linear-gradient(180deg, #f2f5ea, #fbfcf4);
}

.feed-cover-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.feed-cover-label {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8c9a73;
}

.feed-body {
  padding: 18rpx 18rpx 20rpx;
}

.feed-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  color: #4c3d2a;
  font-weight: 700;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 84rpx;
}

.feed-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.feed-user {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.feed-avatar-image,
.feed-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
  flex-shrink: 0;
}

.feed-avatar-image {
  display: block;
  background: #eef3e5;
  margin-right: 12rpx;
}

.feed-avatar {
  background: #eef3e5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.feed-user-copy {
  flex: 1;
  min-width: 0;
}

.feed-user-name {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: #5a4632;
  font-weight: 500;
}

.feed-like {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  column-gap: 6rpx;
  color: #ae9b82;
  font-size: 22rpx;
}

.feed-like.active {
  color: #83946a;
}

.feed-like-icon {
  font-size: 24rpx;
  line-height: 1;
}

.community-empty {
  margin-top: 12rpx;
}

.community-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #a8c08a, #92ab75);
  box-shadow: 0 18rpx 32rpx rgba(146, 168, 114, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.community-fab-icon {
  color: #fffef8;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
}
