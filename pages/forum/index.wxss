.community-page {
  background: linear-gradient(180deg, #fbf7eb 0%, #fff8e7 20%, #f7f9f0 100%);
}

.community-header {
  padding: 8rpx 4rpx 0;
}

.community-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #4b3a28;
}

.community-header-actions {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.community-search {
  flex: 1;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 251, 0.96);
  border: 1px solid #ece2cf;
  color: #ad9777;
  font-size: 24rpx;
}

.community-top-plus {
  width: 88rpx;
  height: 88rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #a8c08a, #92ab75);
  color: #fffef8;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  box-shadow: 0 14rpx 28rpx rgba(146, 168, 114, 0.24);
}

.channel-scroll {
  width: 100%;
  margin-top: 24rpx;
  margin-bottom: 20rpx;
}

.channel-list {
  display: inline-flex;
  padding-right: 24rpx;
}

.channel-item {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 245, 0.96);
  color: #968572;
  font-size: 24rpx;
  margin-right: 16rpx;
  border: 1px solid #ede2ce;
}

.channel-item.active {
  background: linear-gradient(180deg, #f1f5e7, #e5edd7);
  color: #83946a;
  border-color: #d9e2c7;
  box-shadow: 0 10rpx 20rpx rgba(157, 175, 126, 0.16);
}

.community-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.community-column {
  width: 48%;
}

.feed-card {
  background: rgba(255, 255, 252, 0.98);
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1px solid #efe4d1;
  box-shadow: 0 14rpx 28rpx rgba(191, 180, 150, 0.12);
}

.feed-cover-wrap {
  position: relative;
}

.feed-cover {
  width: 100%;
  height: 250rpx;
  display: block;
  background: #f7f2e5;
}

.feed-cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.feed-cover-placeholder.tone-gold {
  background: linear-gradient(180deg, #fff2c7, #fff8e5);
}

.feed-cover-placeholder.tone-cream {
  background: linear-gradient(180deg, #fff9e7, #fffef6);
}

.feed-cover-placeholder.tone-soft {
  background: linear-gradient(180deg, #f2f5ea, #fbfcf4);
}

.feed-cover-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.feed-cover-label {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8c9a73;
}

.feed-video-badge {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(90, 70, 50, 0.72);
  color: #fffef8;
  font-size: 20rpx;
}

.feed-body {
  padding: 18rpx;
}

.feed-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: #4c3d2a;
  font-weight: 700;
}

.feed-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.feed-tag {
  display: inline-block;
  margin-right: 10rpx;
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef3e5;
  color: #87996e;
  font-size: 20rpx;
}

.feed-pet-card {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fbfbf3, #fffdf8);
  border: 1px solid #e9e7d8;
}

.feed-pet-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5a4632;
}

.feed-pet-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #978672;
}

.feed-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.feed-user {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.feed-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eef3e5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.feed-user-copy {
  flex: 1;
  min-width: 0;
}

.feed-user-name,
.feed-user-location {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feed-user-name {
  font-size: 22rpx;
  color: #5a4632;
}

.feed-user-location {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a18f7a;
}

.feed-like {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #fff6df;
  color: #b28b4a;
  font-size: 22rpx;
}

.feed-like.active {
  background: #eef3e5;
  color: #83946a;
}

.community-empty {
  margin-top: 12rpx;
}

.community-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #a8c08a, #92ab75);
  box-shadow: 0 18rpx 32rpx rgba(146, 168, 114, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.community-fab-icon {
  color: #fffef8;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
}
