.community-page {
  background: linear-gradient(180deg, #fbf7eb 0%, #fff8e7 20%, #f7f9f0 100%);
}

.community-search-section {
  margin: -1rpx -24rpx 0;
  padding: 15rpx 28rpx 18rpx;
  background: #fff8e7;
}

.community-search-row,
.smart-nav-row {
  display: flex;
  align-items: center;
}

.community-search-row {
  justify-content: space-between;
}

.community-search {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 246, 0.98);
  border: 1px solid #ece2cf;
  color: #ad9777;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.header-search {
  margin-right: 0;
}

.community-search-icon {
  flex-shrink: 0;
  color: #b2a089;
  font-size: 34rpx;
  margin-right: 10rpx;
  line-height: 1;
}

.community-search-placeholder {
  flex: 1;
  min-width: 0;
  color: #ad9777;
  font-size: 25rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.smart-nav-row {
  position: -webkit-sticky;
  position: sticky;
  top: calc(env(safe-area-inset-top) + 184rpx);
  z-index: 850;
  min-height: 92rpx;
  margin: 0 -24rpx;
  padding: 16rpx 24rpx 10rpx;
  justify-content: center;
  background: rgba(251, 247, 235, 0.98);
  border-bottom: 1px solid rgba(232, 221, 198, 0.72);
  box-sizing: border-box;
}

.filter-entry {
  position: absolute;
  left: 24rpx;
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 252, 0.98);
  border: 1px solid #ece2cf;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(191, 180, 150, 0.1);
}

.filter-line {
  width: 32rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #8c9b73;
  margin: 4rpx 0;
}

.filter-line.short {
  width: 24rpx;
}

.filter-line.tiny {
  width: 16rpx;
}

.smart-channel-list {
  display: flex;
  justify-content: center;
  column-gap: 54rpx;
}

.smart-channel {
  position: relative;
  min-width: 84rpx;
  padding: 12rpx 0 18rpx;
  color: #8f7b67;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.smart-channel.active {
  color: #7f956d;
  font-weight: 800;
}

.smart-channel.active::after {
  content: '';
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  bottom: 4rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #8fa77b;
}

.community-banner-swiper {
  height: 300rpx;
  margin-top: 18rpx;
}

.community-banner-card {
  position: relative;
  height: 280rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 32rpx rgba(191, 180, 150, 0.14);
}

.community-banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.community-banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 24rpx 22rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(70, 53, 39, 0.46) 100%);
}

.community-banner-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fffef8;
}

.community-banner-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 253, 246, 0.92);
}

.community-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 14rpx;
}

.community-column {
  width: 49%;
}

.feed-card {
  background: rgba(255, 255, 252, 0.98);
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
  border: 1px solid #f1e6d5;
  box-shadow: 0 10rpx 24rpx rgba(191, 180, 150, 0.1);
}

.feed-cover-wrap {
  position: relative;
}

.feed-cover {
  width: 100%;
  display: block;
  background: #f7f2e5;
}

.feed-body {
  padding: 18rpx 18rpx 20rpx;
}

.feed-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  color: #4c3d2a;
  font-weight: 800;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.feed-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.feed-user {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.feed-avatar-image {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
  display: block;
  background: #eef3e5;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.feed-user-copy {
  flex: 1;
  min-width: 0;
}

.feed-user-name {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feed-user-name {
  font-size: 22rpx;
  color: #5a4632;
  font-weight: 600;
}

.feed-like {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  column-gap: 6rpx;
  color: #ae9b82;
  font-size: 22rpx;
}

.feed-like.active {
  color: #83946a;
}

.feed-like-icon {
  font-size: 24rpx;
  line-height: 1;
}

.community-empty {
  margin-top: 12rpx;
}

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: calc(env(safe-area-inset-top) + 276rpx);
  bottom: 0;
  z-index: 1200;
  background: rgba(55, 45, 35, 0.28);
}

.filter-drawer {
  position: fixed;
  left: 0;
  top: calc(env(safe-area-inset-top) + 276rpx);
  bottom: 0;
  width: 33.333vw;
  min-width: 248rpx;
  z-index: 1201;
  transform: translateX(-110%);
  transition: transform 0.2s ease;
  background: #fffdf8;
  border-right: 1px solid #eadfca;
  box-shadow: 12rpx 0 30rpx rgba(108, 90, 64, 0.12);
}

.filter-drawer.show {
  transform: translateX(0);
}

.filter-drawer-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 28rpx 18rpx 42rpx;
}

.drawer-title {
  display: block;
  color: #5a4632;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
  line-height: 1.35;
}

.drawer-filter-row {
  padding: 20rpx 0;
  border-bottom: 1px solid #f1e7d8;
}

.drawer-filter-row.active .drawer-filter-name {
  color: #758860;
}

.drawer-filter-name {
  display: block;
  color: #5a4632;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.drawer-reset {
  box-sizing: border-box;
  width: 100%;
  margin-top: 20rpx;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  background: #eef4e5;
  color: #758860;
  font-size: 23rpx;
  font-weight: 800;
  text-align: center;
}

.community-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #a8c08a, #92ab75);
  box-shadow: 0 18rpx 32rpx rgba(146, 168, 114, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.community-fab-icon {
  color: #fffef8;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
}
