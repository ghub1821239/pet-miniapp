.community-page {
  --pin-bg: #FCE7C8;
  --pin-surface: #FFFDF6;
  --pin-text: #5B4A3A;
  --pin-sub: #9A8B7A;
  --pin-border: rgba(250, 218, 122, 0.45);
  --pin-accent: #9CAF88;
  --pin-accent-soft: #EEF5EA;
  --pin-success: #7F956D;
  --pin-warn: #9A8B7A;
  --pin-help: #9A8B7A;
  background: linear-gradient(180deg, #FFFDF6 0%, #FFFDF6 54%, #EEF5EA 100%);
  padding-bottom: 180rpx;
  font-family: 'Avenir Next', 'Trebuchet MS', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
}

.page-topbar {
  margin: -24rpx -24rpx 0;
  padding: calc(env(safe-area-inset-top) + 16rpx) 28rpx 12rpx;
  background: #F7E3AE;
  border-bottom: 1px solid rgba(247, 227, 174, 0.8);
}

.page-topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 58rpx;
  box-sizing: border-box;
}

.brand-lockup {
  display: flex;
  align-items: center;
}

.brand-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--pin-accent);
  margin-right: 12rpx;
}

.brand-text {
  font-size: 36rpx;
  color: var(--pin-text);
  font-weight: 800;
  letter-spacing: 0.4rpx;
}

.brand-cta {
  min-width: 112rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFDF6;
  background: var(--pin-accent);
}

.community-search-section {
  margin: 0 -24rpx;
  padding: 18rpx 28rpx 16rpx;
  background: var(--pin-surface);
}

.community-search-row {
  display: flex;
  align-items: center;
}

.community-search {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 999rpx;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.5);
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.community-search-icon {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #9A8B7A;
  font-size: 32rpx;
  line-height: 1;
}

.community-search-placeholder {
  flex: 1;
  min-width: 0;
  color: #9A8B7A;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.smart-nav-row {
  position: -webkit-sticky;
  position: sticky;
  top: calc(env(safe-area-inset-top) + 160rpx);
  z-index: 850;
  margin: 0 -24rpx;
  min-height: 92rpx;
  padding: 16rpx 24rpx 10rpx;
  background: rgba(255, 253, 246, 0.96);
  border-bottom: 1px solid rgba(250, 218, 122, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  backdrop-filter: saturate(160%) blur(8rpx);
}

.filter-entry {
  position: absolute;
  left: 24rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  border: 1px solid rgba(156, 175, 136, 0.24);
  background: #FFFDF6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.filter-line {
  width: 28rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #7F956D;
  margin: 3rpx 0;
}

.filter-line.short {
  width: 20rpx;
}

.filter-line.tiny {
  width: 14rpx;
}

.smart-channel-list {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.smart-channel {
  min-width: 96rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #9A8B7A;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.48);
  padding: 0 18rpx;
}

.smart-channel.active {
  color: #7F956D;
  background: #EEF5EA;
  border-color: rgba(156, 175, 136, 0.34);
}

.community-banner-swiper {
  height: 286rpx;
  margin-top: 14rpx;
}

.community-banner-card {
  height: 268rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 18rpx rgba(91, 74, 58, 0.1);
}

.community-banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.community-banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 18rpx;
  background: linear-gradient(180deg, rgba(91, 74, 58, 0) 0%, rgba(91, 74, 58, 0.52) 100%);
}

.community-banner-title {
  display: block;
  font-size: 30rpx;
  color: #FFFDF6;
  font-weight: 700;
}

.community-banner-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 253, 246, 0.92);
}

.community-grid {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.community-column {
  width: 49%;
}

.feed-card {
  position: relative;
  background: var(--pin-surface);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
  border: 1px solid rgba(250, 218, 122, 0.35);
  box-shadow: 0 6rpx 14rpx rgba(91, 74, 58, 0.06);
}

.feed-promotion-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  z-index: 3;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  background: rgba(156, 175, 136, 0.92);
  color: #FFFDF6;
  font-size: 20rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 12rpx rgba(91, 74, 58, 0.10);
}

.feed-card-share {
  border-color: rgba(250, 218, 122, 0.35);
}

.feed-card-qa {
  border-color: rgba(156, 175, 136, 0.28);
  background: linear-gradient(180deg, #FFFDF6 0%, #EEF5EA 100%);
}

.feed-card-help {
  border-color: rgba(250, 218, 122, 0.34);
  background: linear-gradient(180deg, #FFFDF6 0%, #FFF4D1 100%);
}

.feed-cover-wrap {
  position: relative;
}

.feed-cover {
  width: 100%;
  display: block;
  background: #EEF5EA;
}

.cover-corner {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  background: rgba(91, 74, 58, 0.62);
}

.cover-corner-text {
  color: #FFFDF6;
  font-size: 20rpx;
  font-weight: 700;
}

.feed-body {
  padding: 16rpx;
}

.qa-body,
.help-body {
  padding: 18rpx 16rpx 16rpx;
}

.card-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.card-chip {
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #7F956D;
  background: #EEF5EA;
  display: inline-flex;
  align-items: center;
}

.card-chip-qa {
  background: #EEF5EA;
  color: #7F956D;
}

.card-chip-help {
  background: #FFF4D1;
  color: #9A8B7A;
}

.feed-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--pin-text);
  font-weight: 800;
}

.share-title {
  -webkit-line-clamp: 2;
}

.qa-title,
.help-title {
  -webkit-line-clamp: 2;
}

.qa-summary,
.help-summary {
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.55;
  color: #9A8B7A;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.status-badge {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
}

.status-done {
  color: #7F956D;
  background: #EEF5EA;
}

.status-pending {
  color: #9A8B7A;
  background: #FFF4D1;
}

.status-urgent {
  color: #9A8B7A;
  background: #FFF4D1;
}

.status-neutral {
  color: #5B4A3A;
  background: #FFF8E5;
}

.status-meta {
  margin-left: 10rpx;
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #9A8B7A;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feed-footer {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feed-user {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.feed-avatar-image {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: block;
  background: rgba(250, 218, 122, 0.32);
  margin-right: 10rpx;
}

.feed-user-copy {
  flex: 1;
  min-width: 0;
}

.feed-user-name {
  display: block;
  font-size: 22rpx;
  color: #5B4A3A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feed-like {
  flex-shrink: 0;
  height: 44rpx;
  min-width: 84rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(250, 218, 122, 0.35);
  color: #9A8B7A;
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.feed-like.active {
  color: #7F956D;
  border-color: rgba(156, 175, 136, 0.36);
  background: var(--pin-accent-soft);
}

.feed-like-icon {
  line-height: 1;
}

.community-empty {
  margin-top: 14rpx;
  background: #FFFDF6;
  border-radius: 20rpx;
  border: 1px solid rgba(250, 218, 122, 0.35);
}

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: calc(env(safe-area-inset-top) + 248rpx);
  bottom: 0;
  z-index: 1200;
  background: rgba(91, 74, 58, 0.22);
}

.filter-drawer {
  position: fixed;
  left: 0;
  top: calc(env(safe-area-inset-top) + 248rpx);
  bottom: 0;
  width: 36vw;
  min-width: 268rpx;
  z-index: 1201;
  transform: translateX(-108%);
  transition: transform 0.22s ease;
  background: #FFFDF6;
  border-right: 1px solid rgba(250, 218, 122, 0.45);
  box-shadow: 10rpx 0 28rpx rgba(91, 74, 58, 0.12);
}

.filter-drawer.show {
  transform: translateX(0);
}

.filter-drawer-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 18rpx 40rpx;
}

.drawer-title {
  display: block;
  font-size: 30rpx;
  color: var(--pin-text);
  font-weight: 800;
  margin-bottom: 18rpx;
}

.drawer-filter-row {
  padding: 16rpx 0;
  border-bottom: 1px solid rgba(250, 218, 122, 0.32);
}

.drawer-filter-row.active .drawer-filter-name {
  color: var(--pin-accent);
}

.drawer-filter-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5B4A3A;
}

.drawer-reset {
  width: 100%;
  margin-top: 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  color: #FFFDF6;
  background: var(--pin-accent);
}

.community-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--pin-accent);
  box-shadow: 0 14rpx 30rpx rgba(156, 175, 136, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.community-fab-icon {
  color: #FFFDF6;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
}
