.community-page {
  --pin-bg: #f5f5f5;
  --pin-surface: #ffffff;
  --pin-text: #151515;
  --pin-sub: #6b6b6b;
  --pin-border: #ebebeb;
  --pin-accent: #e60023;
  --pin-accent-soft: #ffe8ee;
  --pin-success: #237a44;
  --pin-warn: #9b5a00;
  --pin-help: #8f2f21;
  background: var(--pin-bg);
  padding-bottom: 180rpx;
  font-family: 'Avenir Next', 'Trebuchet MS', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
}

.page-topbar {
  margin: -1rpx -24rpx 0;
  padding: calc(env(safe-area-inset-top) + 16rpx) 28rpx 12rpx;
  background: var(--pin-surface);
  border-bottom: 1px solid var(--pin-border);
}

.page-topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-lockup {
  display: flex;
  align-items: center;
}

.brand-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--pin-accent);
  margin-right: 12rpx;
}

.brand-text {
  font-size: 36rpx;
  color: var(--pin-text);
  font-weight: 800;
  letter-spacing: 0.4rpx;
}

.brand-cta {
  min-width: 112rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: var(--pin-accent);
}

.community-search-section {
  margin: 0 -24rpx;
  padding: 18rpx 28rpx 16rpx;
  background: var(--pin-surface);
}

.community-search-row {
  display: flex;
  align-items: center;
}

.community-search {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  border: 1px solid #efefef;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.community-search-icon {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #9b9b9b;
  font-size: 32rpx;
  line-height: 1;
}

.community-search-placeholder {
  flex: 1;
  min-width: 0;
  color: #9b9b9b;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-tip-row {
  margin-top: 10rpx;
}

.search-tip {
  display: block;
  font-size: 22rpx;
  color: #8f8f8f;
}

.smart-nav-row {
  position: -webkit-sticky;
  position: sticky;
  top: calc(env(safe-area-inset-top) + 160rpx);
  z-index: 850;
  margin: 0 -24rpx;
  min-height: 92rpx;
  padding: 16rpx 24rpx 10rpx;
  background: rgba(245, 245, 245, 0.96);
  border-bottom: 1px solid #ebebeb;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  backdrop-filter: saturate(160%) blur(8rpx);
}

.filter-entry {
  position: absolute;
  left: 24rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  border: 1px solid #e3e3e3;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.filter-line {
  width: 28rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #5a5a5a;
  margin: 3rpx 0;
}

.filter-line.short {
  width: 20rpx;
}

.filter-line.tiny {
  width: 14rpx;
}

.smart-channel-list {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.smart-channel {
  min-width: 96rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #4f4f4f;
  background: #ececec;
  padding: 0 18rpx;
}

.smart-channel.active {
  color: #fff;
  background: var(--pin-text);
}

.community-banner-swiper {
  height: 214rpx;
  margin-top: 14rpx;
}

.community-banner-card {
  height: 196rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.08);
}

.community-banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.community-banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 18rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.52) 100%);
}

.community-banner-title {
  display: block;
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
}

.community-banner-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
}

.feed-meta-row {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.feed-meta-main {
  min-width: 0;
}

.feed-meta-title {
  display: block;
  font-size: 34rpx;
  color: var(--pin-text);
  font-weight: 800;
}

.feed-meta-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.feed-meta-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.feed-meta-tag {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--pin-accent-soft);
  color: var(--pin-accent);
  font-size: 20rpx;
  font-weight: 700;
}

.community-grid {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.community-column {
  width: 49%;
}

.feed-card {
  background: var(--pin-surface);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
  border: 1px solid #ececec;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.05);
}

.feed-card-share {
  border-color: #ececec;
}

.feed-card-qa {
  border-color: #dceadf;
  background: linear-gradient(180deg, #ffffff 0%, #f8fcf6 100%);
}

.feed-card-help {
  border-color: #f0ddd3;
  background: linear-gradient(180deg, #ffffff 0%, #fff8f4 100%);
}

.feed-cover-wrap {
  position: relative;
}

.feed-cover {
  width: 100%;
  display: block;
  background: #f2f2f2;
}

.cover-corner {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.62);
}

.cover-corner-text {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.feed-body {
  padding: 16rpx;
}

.qa-body,
.help-body {
  padding: 18rpx 16rpx 16rpx;
}

.card-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.card-chip {
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #5d5d5d;
  background: #f2f2f2;
  display: inline-flex;
  align-items: center;
}

.card-chip-qa {
  background: #e8f3e8;
  color: #2f6a41;
}

.card-chip-help {
  background: #fde8e0;
  color: #9a3f33;
}

.feed-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--pin-text);
  font-weight: 800;
}

.share-title {
  -webkit-line-clamp: 2;
}

.qa-title,
.help-title {
  -webkit-line-clamp: 2;
}

.qa-summary,
.help-summary {
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.55;
  color: #595959;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.status-badge {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
}

.status-done {
  color: #25693d;
  background: #dff2e2;
}

.status-pending {
  color: #8b5a12;
  background: #f9efcf;
}

.status-urgent {
  color: #9b2f21;
  background: #fde0d7;
}

.status-neutral {
  color: #545454;
  background: #efefef;
}

.status-meta {
  margin-left: 10rpx;
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #7f7f7f;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feed-footer {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feed-user {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.feed-avatar-image {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: block;
  background: #f0f0f0;
  margin-right: 10rpx;
}

.feed-user-copy {
  flex: 1;
  min-width: 0;
}

.feed-user-name {
  display: block;
  font-size: 22rpx;
  color: #575757;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feed-like {
  flex-shrink: 0;
  height: 44rpx;
  min-width: 84rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  border: 1px solid #ededed;
  color: #858585;
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.feed-like.active {
  color: var(--pin-accent);
  border-color: #f6ccd6;
  background: var(--pin-accent-soft);
}

.feed-like-icon {
  line-height: 1;
}

.community-empty {
  margin-top: 14rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1px solid #ececec;
}

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: calc(env(safe-area-inset-top) + 248rpx);
  bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.22);
}

.filter-drawer {
  position: fixed;
  left: 0;
  top: calc(env(safe-area-inset-top) + 248rpx);
  bottom: 0;
  width: 36vw;
  min-width: 268rpx;
  z-index: 1201;
  transform: translateX(-108%);
  transition: transform 0.22s ease;
  background: #fff;
  border-right: 1px solid #ebebeb;
  box-shadow: 10rpx 0 28rpx rgba(0, 0, 0, 0.1);
}

.filter-drawer.show {
  transform: translateX(0);
}

.filter-drawer-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 18rpx 40rpx;
}

.drawer-title {
  display: block;
  font-size: 30rpx;
  color: var(--pin-text);
  font-weight: 800;
  margin-bottom: 18rpx;
}

.drawer-filter-row {
  padding: 16rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.drawer-filter-row.active .drawer-filter-name {
  color: var(--pin-accent);
}

.drawer-filter-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #565656;
}

.drawer-reset {
  width: 100%;
  margin-top: 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  color: #fff;
  background: var(--pin-accent);
}

.community-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--pin-accent);
  box-shadow: 0 14rpx 30rpx rgba(230, 0, 35, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.community-fab-icon {
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
}
