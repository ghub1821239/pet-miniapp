.forum-btn-row {
  display: flex;
  margin-top: 18rpx;
}

.forum-btn-row button {
  margin-right: 16rpx;
}

.forum-submit {
  margin-top: 20rpx;
}

.forum-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.forum-user {
  display: flex;
  align-items: center;
}

.forum-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff0f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 14rpx;
}

.forum-user-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.forum-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.forum-content {
  margin-top: 18rpx;
  line-height: 1.8;
  color: #333;
}

.forum-image-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.forum-thumb {
  width: 31%;
  height: 190rpx;
  border-radius: 16rpx;
  margin-right: 2%;
  margin-bottom: 12rpx;
  background: #f6f6f6;
}

.forum-action-row {
  margin-top: 12rpx;
}

.forum-comment-box {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f5e7ee;
}

.forum-comment-line {
  font-size: 24rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.forum-comment-user {
  color: #ff5f90;
  font-weight: 700;
}

.forum-comment-btn-wrap {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}