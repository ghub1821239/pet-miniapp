<view class="page-container">
  <view class="top-switch">
    <view class="switch-item active">日程</view>
    <navigator class="switch-item" url="/pages/todo/index" open-type="redirect">待办</navigator>
  </view>

  <view class="header-card">
    <view class="header-left">
      <view class="header-kicker">PET CALENDAR</view>
      <view class="header-title">{{monthText}}</view>
      <view class="header-subtitle">当前选中 {{selectedDate}}，今日提醒 {{todayList.length}} 条</view>
    </view>
    <view class="add-btn" bindtap="openAddModal">+ 新增提醒</view>
  </view>

  <view class="card card-calendar">
    <view class="calendar-top">
      <view class="month-bar">
        <text class="month-arrow" bindtap="prevMonth">〈</text>
        <text class="month-text">{{monthText}}</text>
        <text class="month-arrow" bindtap="nextMonth">〉</text>
      </view>

      <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
        <view class="date-picker-btn">选择日期：{{selectedDate}}</view>
      </picker>
    </view>

    <view class="week-row">
      <view class="week-item">日</view>
      <view class="week-item">一</view>
      <view class="week-item">二</view>
      <view class="week-item">三</view>
      <view class="week-item">四</view>
      <view class="week-item">五</view>
      <view class="week-item">六</view>
    </view>

    <view class="day-grid">
      <block wx:for="{{calendarList}}" wx:key="index">
        <view class="day-wrap">
          <view
            class="day-cell {{item.empty ? 'empty-cell' : ''}} {{item.isToday ? 'today-cell' : ''}} {{item.isSelected ? 'selected-cell' : ''}}"
            data-date="{{item.date}}"
            bindtap="selectDay"
          >
            <text class="day-num">{{item.text}}</text>
            <view wx:if="{{item.hasReminder && !item.empty}}" class="dot"></view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="card card-highlight">
    <view class="section-head">
      <view>
        <view class="section-kicker">TODAY</view>
        <view class="section-title">今日提醒</view>
      </view>
      <view class="section-badge">{{todayList.length}}</view>
    </view>
    <block wx:if="{{todayList.length > 0}}">
      <block wx:for="{{todayList}}" wx:key="id">
        <view class="reminder-item">
          <text class="reminder-title">{{item.title}}</text>
          <view class="meta-row">
            <text class="tag">{{item.category}}</text>
            <text class="reminder-time reminder-time-strong">{{item.time}}</text>
          </view>
        </view>
      </block>
    </block>
    <view wx:else class="empty">今天没有提醒</view>
  </view>

  <view class="card">
    <view class="section-head">
      <view>
        <view class="section-kicker">SELECTED DATE</view>
        <view class="section-title">当日事项</view>
      </view>
      <view class="section-badge section-badge-muted">{{selectedList.length}}</view>
    </view>
    <block wx:if="{{selectedList.length > 0}}">
      <block wx:for="{{selectedList}}" wx:key="id">
        <view class="reminder-item">
          <text class="reminder-title">{{item.title}}</text>
          <view class="meta-row">
            <text class="tag">{{item.category}}</text>
            <text class="reminder-time">{{item.date}} {{item.time}}</text>
          </view>
        </view>
      </block>
    </block>
    <view wx:else class="empty">{{isSelectedToday ? '今天的事项已在今日提醒中显示' : '该日期暂无提醒'}}</view>
  </view>

  <view class="card quick-card">
  <view class="section-head">
    <view>
      <view class="section-kicker">QUICK ACTIONS</view>
      <view class="section-title">常见事项</view>
    </view>
  </view>

  <view class="quick-list">
    <view class="quick-row quick-row-feed">
      <view>
        <view class="quick-label">今日喂食</view>
        <view class="quick-name">喂食</view>
      </view>
      <view class="feed-entry">
        <view class="feed-tip">早餐 / 午餐 / 晚餐</view>
        <view class="feed-add-btn" data-category="喂食" bindtap="quickAdd">＋</view>
      </view>
    </view>

    <view class="quick-row">
      <view class="quick-name">洗澡</view>
      <view class="quick-actions-inline">
        <view
          class="action-btn {{quickStatusMap['洗澡'] === 'done' ? 'action-btn-active' : 'action-btn-idle'}}"
          data-category="洗澡"
          data-done="true"
          bindtap="quickChooseStatus"
        >
          已做
        </view>
        <view
          class="action-btn {{quickStatusMap['洗澡'] === 'undo' ? 'action-btn-active-gray' : 'action-btn-idle'}}"
          data-category="洗澡"
          data-done="false"
          bindtap="quickChooseStatus"
        >
          未做
        </view>
      </view>
    </view>

    <view class="quick-row">
      <view class="quick-name">驱虫</view>
      <view class="quick-actions-inline">
        <view
          class="action-btn {{quickStatusMap['驱虫'] === 'done' ? 'action-btn-active' : 'action-btn-idle'}}"
          data-category="驱虫"
          data-done="true"
          bindtap="quickChooseStatus"
        >
          已做
        </view>
        <view
          class="action-btn {{quickStatusMap['驱虫'] === 'undo' ? 'action-btn-active-gray' : 'action-btn-idle'}}"
          data-category="驱虫"
          data-done="false"
          bindtap="quickChooseStatus"
        >
          未做
        </view>
      </view>
    </view>

    <view class="quick-row">
      <view class="quick-name">散步</view>
      <view class="quick-actions-inline">
        <view
          class="action-btn {{quickStatusMap['散步'] === 'done' ? 'action-btn-active' : 'action-btn-idle'}}"
          data-category="散步"
          data-done="true"
          bindtap="quickChooseStatus"
        >
          已做
        </view>
        <view
          class="action-btn {{quickStatusMap['散步'] === 'undo' ? 'action-btn-active-gray' : 'action-btn-idle'}}"
          data-category="散步"
          data-done="false"
          bindtap="quickChooseStatus"
        >
          未做
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showFeedPanel}}" class="mask" bindtap="closePanel"></view>
<view wx:if="{{showFeedPanel}}" class="bottom-panel">
  <view class="panel-kicker">FEED PLAN</view>
  <view class="panel-title">选择喂食时段</view>
  <view class="panel-subtitle">记录今天是哪一餐，稍后会自动加入提醒列表。</view>
  <view class="panel-options">
    <view class="panel-btn" data-period="morning" bindtap="chooseFeed">早餐</view>
    <view class="panel-btn" data-period="noon" bindtap="chooseFeed">午餐</view>
    <view class="panel-btn" data-period="evening" bindtap="chooseFeed">晚餐</view>
  </view>
</view>

<pet-tabbar current="calendar"></pet-tabbar>
</view>
