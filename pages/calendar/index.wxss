.reminder-item {
  padding: 18rpx 0;
  border-bottom: 1px solid #f5e7ee;
}

.reminder-done {
  opacity: 0.75;
}

.reminder-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.reminder-time {
  display: block;
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
}

.reminder-btns {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.reminder-btns button {
  margin-top: 8rpx;
}