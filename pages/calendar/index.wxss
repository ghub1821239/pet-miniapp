.page-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(255, 232, 240, 0.95), transparent 30%),
    linear-gradient(180deg, #fff8fb 0%, #f7f2f5 100%);
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.top-switch {
  display: flex;
  width: 220rpx;
  background: #fff0f5;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #666;
  font-size: 28rpx;
  text-decoration: none;
}

.switch-item.active {
  background: #ff8fb1;
  color: #fff;
  font-weight: 700;
}

.header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #ffe4ee 0%, #fff5f9 100%);
  border-radius: 30rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(255, 143, 177, 0.12);
}

.header-left {
  flex: 1;
  padding-right: 20rpx;
}

.header-kicker {
  font-size: 22rpx;
  color: #c9839f;
  letter-spacing: 4rpx;
}

.header-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #2f2a2d;
}

.header-subtitle {
  margin-top: 12rpx;
  color: #7f737a;
  font-size: 26rpx;
  line-height: 1.5;
}

.add-btn {
  background: #ff8fb1;
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(37, 24, 32, 0.05);
}

.card-calendar {
  border: 2rpx solid #ffdbe7;
}

.card-highlight {
  background: linear-gradient(180deg, #fff6fa 0%, #ffffff 100%);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-kicker {
  font-size: 20rpx;
  color: #c48aa0;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.section-badge {
  min-width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ffeef4;
  color: #ff6b9a;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.section-badge-muted {
  background: #f4eef2;
  color: #776d73;
}

.calendar-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 20rpx;
}

.month-bar {
  display: flex;
  align-items: center;
}

.month-arrow {
  font-size: 34rpx;
  color: #ff8fb1;
  font-weight: 700;
  padding: 0 16rpx;
}

.month-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f2a2d;
  min-width: 150rpx;
  text-align: center;
}

.date-picker-btn {
  background: #fff3f8;
  border: 2rpx solid #ffd6e3;
  border-radius: 18rpx;
  padding: 14rpx 22rpx;
  color: #6e656a;
  font-size: 24rpx;
  white-space: nowrap;
}

.week-row {
  display: flex;
  margin-bottom: 16rpx;
}

.week-item {
  width: 14.2857%;
  text-align: center;
  color: #a09299;
  font-size: 24rpx;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-wrap {
  width: 14.2857%;
  padding: 6rpx;
  box-sizing: border-box;
}

.day-cell {
  height: 92rpx;
  border-radius: 22rpx;
  background: #fff9fb;
  border: 2rpx solid #f5e4eb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.empty-cell {
  background: transparent;
  border: none;
}

.day-num {
  font-size: 28rpx;
  color: #3a3438;
}

.today-cell {
  background: #fff2f7;
  border-color: #ffc2d5;
}

.today-cell .day-num {
  color: #ff5d97;
  font-weight: 700;
}

.selected-cell {
  background: linear-gradient(180deg, #ff95b5 0%, #ff799f 100%);
  border-color: #ff8fb1;
  box-shadow: 0 10rpx 20rpx rgba(255, 143, 177, 0.22);
}

.selected-cell .day-num {
  color: #fff;
  font-weight: 700;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #ff6b9a;
  border-radius: 50%;
  margin-top: 8rpx;
}

.selected-cell .dot {
  background: #fff;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2f2a2d;
  margin-bottom: 0;
}

.reminder-item {
  padding: 20rpx 0;
  border-bottom: 1px solid #f6e8ee;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-title {
  font-size: 30rpx;
  color: #2f2a2d;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff2f7;
  color: #ff6b9a;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.reminder-time {
  color: #8d8389;
  font-size: 24rpx;
}

.reminder-time-strong {
  color: #5c5358;
  font-weight: 600;
}

.empty {
  text-align: center;
  color: #b4aab0;
  font-size: 28rpx;
  padding: 60rpx 0 40rpx;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.quick-wrap {
  width: 25%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.quick-item {
  min-height: 108rpx;
  background: #fff2f7;
  color: #ff6b9a;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.quick-plus {
  font-size: 34rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.25);
  z-index: 1200;
}

.bottom-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  z-index: 1201;
}

.panel-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.panel-kicker {
  font-size: 20rpx;
  color: #c48aa0;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.panel-subtitle {
  color: #857a80;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.panel-options {
  display: flex;
  gap: 20rpx;
}

.panel-btn {
  flex: 1;
  text-align: center;
  background: linear-gradient(180deg, #fff3f8 0%, #ffe8f0 100%);
  color: #ff6b9a;
  border-radius: 22rpx;
  padding: 28rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}
.quick-list {
  margin-top: 8rpx;
}

.quick-card {
  background: linear-gradient(180deg, #fffafc 0%, #ffffff 100%);
}

.quick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1px solid #f6e8ee;
}

.quick-row-feed {
  align-items: center;
}

.quick-row:last-child {
  border-bottom: none;
}

.quick-label {
  font-size: 22rpx;
  color: #c48aa0;
  margin-bottom: 8rpx;
}

.quick-name {
  font-size: 30rpx;
  color: #2f2a2d;
  font-weight: 600;
}

.feed-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.feed-tip {
  color: #8d8288;
  font-size: 22rpx;
}

.quick-actions-inline {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  min-width: 110rpx;
  text-align: center;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.action-btn-idle {
  background: #f2f2f2;
  color: #9b9b9b;
}

.feed-add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8fb1 0%, #ff6f9b 100%);
  color: #fff;
  text-align: center;
  line-height: 64rpx;
  font-size: 40rpx;
  font-weight: 700;
}
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.25);
  z-index: 1200;
}

.bottom-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  z-index: 1201;
}

.action-btn-active {
  background: #ff8fb1;
  color: #fff;
}

.action-btn-active-gray {
  background: #666;
  color: #fff;
}
