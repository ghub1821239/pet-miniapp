.page-container {
  min-height: 100vh;
  background: #fdf6fa;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.top-switch {
  display: flex;
  width: 220rpx;
  background: #fff0f5;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #666;
  font-size: 28rpx;
  text-decoration: none;
}

.switch-item.active {
  background: #ff8fb1;
  color: #fff;
  font-weight: 700;
}

.header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffe7f0;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.header-left {
  flex: 1;
  padding-right: 20rpx;
}

.header-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #333;
}

.header-subtitle {
  margin-top: 12rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 1.5;
}

.add-btn {
  background: #ff8fb1;
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.calendar-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-bar {
  display: flex;
  align-items: center;
}

.month-arrow {
  font-size: 34rpx;
  color: #ff8fb1;
  font-weight: 700;
  padding: 0 16rpx;
}

.month-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  min-width: 150rpx;
  text-align: center;
}

.date-picker-btn {
  background: #fff5f8;
  border: 2rpx solid #ffd6e3;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  color: #666;
  font-size: 24rpx;
}

.week-row {
  display: flex;
  margin-bottom: 16rpx;
}

.week-item {
  width: 14.2857%;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-wrap {
  width: 14.2857%;
  padding: 6rpx;
  box-sizing: border-box;
}

.day-cell {
  height: 88rpx;
  border-radius: 18rpx;
  background: #fff7fa;
  border: 2rpx solid #ffd6e3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.empty-cell {
  background: transparent;
  border: none;
}

.day-num {
  font-size: 28rpx;
  color: #333;
}

.today-cell {
  background: #fff0f5;
  border-color: #ff8fb1;
}

.today-cell .day-num {
  color: #ff5d97;
  font-weight: 700;
}

.selected-cell {
  background: #ff8fb1;
  border-color: #ff8fb1;
}

.selected-cell .day-num {
  color: #fff;
  font-weight: 700;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  background: #ff6b9a;
  border-radius: 50%;
  margin-top: 8rpx;
}

.selected-cell .dot {
  background: #fff;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.reminder-item {
  padding: 20rpx 0;
  border-bottom: 1px solid #f6e8ee;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-title {
  font-size: 30rpx;
  color: #333;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff2f7;
  color: #ff6b9a;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.reminder-time {
  color: #999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 60rpx 0 40rpx;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.quick-wrap {
  width: 25%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.quick-item {
  min-height: 108rpx;
  background: #fff2f7;
  color: #ff6b9a;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.quick-plus {
  font-size: 34rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.25);
  z-index: 99;
}

.bottom-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  z-index: 100;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.panel-options {
  display: flex;
  gap: 20rpx;
}

.panel-btn {
  flex: 1;
  text-align: center;
  background: #fff2f7;
  color: #ff6b9a;
  border-radius: 18rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}