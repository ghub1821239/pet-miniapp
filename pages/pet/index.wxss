.profile-page {
  min-height: 100vh;
  padding: 0 0 calc(180rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #FCE7C8 0%, #FFFDF6 34%, #F5F8EE 100%);
}

.profile-hero {
  position: relative;
  min-height: 610rpx;
  padding: calc(env(safe-area-inset-top) + 34rpx) 32rpx 34rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: #FFFDF6;
}

.profile-cover {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.profile-cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(91, 74, 58, 0.34) 0%, rgba(91, 74, 58, 0.74) 100%);
  backdrop-filter: blur(2rpx);
}

.profile-top-actions,
.profile-main-info,
.profile-stats-row,
.profile-tag-row {
  position: relative;
  z-index: 2;
}

.profile-top-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-menu-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 46rpx;
  color: #FFFDF6;
}

.profile-edit-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 246, 0.24);
  color: #FFFDF6;
  font-size: 26rpx;
  font-weight: 700;
  backdrop-filter: blur(8rpx);
}

.profile-edit-btn::after {
  border: none;
}

.profile-main-info {
  display: flex;
  align-items: center;
  margin-top: 92rpx;
}

.profile-avatar {
  width: 166rpx;
  height: 166rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 253, 246, 0.92);
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.18);
  flex-shrink: 0;
}

.profile-text-block {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.profile-name {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #FFFDF6;
}

.profile-id {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: rgba(255, 253, 246, 0.76);
}

.profile-bio {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #FFFDF6;
}

.profile-stats-row {
  display: flex;
  margin-top: 42rpx;
}

.profile-stat-item {
  flex: 1;
}

.profile-stat-value {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #FFFDF6;
}

.profile-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 253, 246, 0.78);
}

.profile-tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 34rpx;
}

.profile-tag {
  margin-right: 14rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(238, 245, 234, 0.22);
  color: #FFFDF6;
  font-size: 24rpx;
  border: 1px solid rgba(255, 253, 246, 0.22);
}

.profile-section {
  margin: 24rpx 24rpx 0;
  padding: 26rpx 0;
  border-radius: 30rpx;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.42);
  box-shadow: 0 10rpx 26rpx rgba(91, 74, 58, 0.07);
}

.profile-section-head {
  padding: 0 24rpx;
}

.profile-section-title {
  display: block;
  font-size: 32rpx;
  color: #5B4A3A;
  font-weight: 800;
}

.profile-section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9A8B7A;
}

.profile-add-pet {
  margin-top: 4rpx;
}

.pet-card-scroll {
  margin-top: 22rpx;
  width: 100%;
  white-space: nowrap;
}

.profile-pet-card {
  display: inline-block;
  vertical-align: top;
  width: 590rpx;
  margin-left: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFDF6 0%, #F8FBF3 100%);
  border: 1px solid rgba(156, 175, 136, 0.18);
  box-shadow: 0 10rpx 24rpx rgba(91, 74, 58, 0.06);
}

.profile-pet-card:last-child {
  margin-right: 24rpx;
}

.profile-pet-card.active {
  border-color: rgba(156, 175, 136, 0.62);
  box-shadow: 0 12rpx 28rpx rgba(127, 149, 109, 0.16);
}

.profile-pet-card-top {
  display: flex;
  align-items: center;
}

.profile-pet-avatar-wrap {
  width: 118rpx;
  height: 118rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-pet-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFDF6;
}

.profile-pet-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFDF6;
  font-size: 36rpx;
  font-weight: 800;
}

.profile-pet-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.profile-pet-name-row {
  display: flex;
  align-items: center;
}

.profile-pet-name {
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  color: #5B4A3A;
  font-weight: 800;
}

.profile-pet-type {
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #7F956D;
  font-size: 22rpx;
}

.profile-pet-meta {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: #9A8B7A;
}

.profile-pet-info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.profile-pet-info-item {
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(238, 245, 234, 0.55);
}

.profile-pet-info-label {
  display: block;
  font-size: 21rpx;
  color: #9A8B7A;
}

.profile-pet-info-value {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5B4A3A;
  font-weight: 700;
}

.profile-pet-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  white-space: normal;
}

.profile-pet-tag {
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: #FFF8E5;
  color: #99763C;
  font-size: 21rpx;
  border: 1px solid rgba(250, 218, 122, 0.52);
}

.profile-pet-reminder {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 23rpx;
  color: #7F956D;
}

.profile-empty-pets {
  margin: 24rpx;
  padding: 58rpx 28rpx;
  text-align: center;
  border-radius: 30rpx;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.42);
}

.empty-pet-emoji {
  display: block;
  font-size: 66rpx;
}

.empty-pet-title {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #5B4A3A;
  font-weight: 800;
}

.empty-pet-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9A8B7A;
}

.empty-pet-btn {
  margin-top: 24rpx;
}

.profile-post-section {
  padding-top: 0;
  overflow: hidden;
}

.profile-tabs {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 20rpx;
  border-bottom: 1px solid rgba(250, 218, 122, 0.36);
}

.profile-tab {
  position: relative;
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9A8B7A;
}

.profile-tab-label {
  font-size: 28rpx;
  font-weight: 700;
}

.profile-tab-count {
  margin-left: 8rpx;
  font-size: 22rpx;
}

.profile-tab.active {
  color: #5B4A3A;
}

.profile-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 62rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #9CAF88;
  transform: translateX(-50%);
}

.profile-post-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  padding: 24rpx;
}

.profile-post-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.36);
  box-shadow: 0 8rpx 18rpx rgba(91, 74, 58, 0.06);
}

.profile-post-cover {
  width: 100%;
  height: 250rpx;
  display: block;
  background: #EEF5EA;
}

.profile-post-body {
  padding: 16rpx;
}

.profile-post-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 74rpx;
  font-size: 26rpx;
  line-height: 1.42;
  color: #5B4A3A;
  font-weight: 800;
}

.profile-post-summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 8rpx;
  min-height: 60rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #9A8B7A;
}

.profile-post-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.profile-post-chip {
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #7F956D;
  font-size: 20rpx;
}

.profile-post-date {
  font-size: 20rpx;
  color: #B2A696;
}

.profile-post-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #9A8B7A;
}

.profile-post-empty {
  padding: 70rpx 20rpx;
  text-align: center;
}

.profile-post-empty-title {
  display: block;
  font-size: 30rpx;
  color: #5B4A3A;
  font-weight: 800;
}

.profile-post-empty-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9A8B7A;
}

.pet-form-modal {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.pet-form-actions {
  display: flex;
  gap: 16rpx;
  position: sticky;
  bottom: 0;
  padding-top: 18rpx;
  background: linear-gradient(180deg, rgba(255, 253, 246, 0), #FFFDF6 30%, #FFFDF6 100%);
}

.pet-form-actions button {
  flex: 1;
}

.avatar-choice {
  width: 72rpx;
  height: 72rpx;
  margin: 12rpx 12rpx 0 0;
  border-radius: 50%;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.52);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.avatar-choice.active {
  background: #EEF5EA;
  border-color: #9CAF88;
}

.pet-readonly-box {
  color: #9A8B7A;
}
/* 个人资料页本次修正：隐藏无功能菜单，账号编辑与宠物编辑分离 */
.profile-top-actions {
  justify-content: flex-end;
}

.profile-menu-icon {
  display: none;
}

.profile-edit-btn {
  min-width: 200rpx;
  text-align: center;
}

/* 宠物卡片内部编辑按钮 */
.profile-pet-title-area {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.profile-pet-name-row {
  justify-content: space-between;
  gap: 12rpx;
}

.profile-pet-edit-btn {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 48rpx;
  line-height: 48rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #7F956D;
  font-size: 22rpx;
  font-weight: 700;
}

.profile-pet-edit-btn::after {
  border: none;
}

/* 账号资料弹窗 */
.profile-account-modal,
.pet-form-modal {
  max-height: 86vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.profile-account-modal .field-label,
.pet-form-modal .field-label {
  display: block;
  margin-top: 22rpx;
  margin-bottom: 10rpx;
  line-height: 1.45;
}

.profile-account-modal .input,
.pet-form-modal .input {
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  display: block;
  box-sizing: border-box;
  padding: 0 22rpx;
  margin-top: 0;
  font-size: 28rpx;
  color: #5B4A3A;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.45);
  border-radius: 18rpx;
}

.profile-account-modal .picker-box,
.pet-form-modal .picker-box {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 22rpx;
  margin-top: 0;
  font-size: 28rpx;
  color: #5B4A3A;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.45);
  border-radius: 18rpx;
}

.profile-bio-textarea {
  min-height: 150rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  margin-top: 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #5B4A3A;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.45);
  border-radius: 18rpx;
}

.profile-form-number-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 4rpx;
}

.profile-form-number-item .field-label {
  margin-top: 16rpx;
}

.profile-form-image-row {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.profile-form-preview-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFDF6;
  box-shadow: 0 8rpx 20rpx rgba(91, 74, 58, 0.12);
  background: #EEF5EA;
}

.profile-form-image-btn {
  margin-left: 20rpx;
}

.profile-form-cover-box {
  position: relative;
  margin-top: 4rpx;
  overflow: hidden;
  height: 190rpx;
  border-radius: 24rpx;
  border: 1px solid rgba(250, 218, 122, 0.45);
  background: #EEF5EA;
}

.profile-form-preview-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-form-cover-btn {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  background: rgba(255, 253, 246, 0.92);
}

.profile-form-actions,
.pet-form-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: sticky;
  bottom: 0;
  z-index: 6;
  margin-top: 28rpx;
  padding-top: 18rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 253, 246, 0), #FFFDF6 24%, #FFFDF6 100%);
}

.profile-form-actions button,
.pet-form-actions button {
  flex: 1;
  margin: 0;
}

.profile-form-actions button::after,
.pet-form-actions button::after,
.profile-edit-btn::after {
  border: none;
}
