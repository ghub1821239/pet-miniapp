.pet-page {
  background: linear-gradient(180deg, #fbf7eb 0%, #fdf9ef 38%, #f5f8ee 100%);
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.archive-hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  overflow: hidden;
}

.hero-copy {
  flex: 1;
  padding-right: 18rpx;
}

.hero-btn {
  margin-top: 24rpx;
}

.hero-decor {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
}

.hero-paw {
  position: absolute;
  right: 14rpx;
  top: 6rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 253, 246, 0.75);
  font-size: 42rpx;
  box-shadow: 0 12rpx 26rpx rgba(191, 180, 150, 0.1);
}

.hero-bubble {
  position: absolute;
  left: 8rpx;
  bottom: 10rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(240, 160, 75, 0.14);
  color: #f0a04b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.hero-dot {
  position: absolute;
  border-radius: 50%;
}

.hero-dot-green {
  right: 2rpx;
  bottom: 28rpx;
  width: 20rpx;
  height: 20rpx;
  background: #b1c29e;
}

.hero-dot-yellow {
  left: 18rpx;
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
  background: #fada7a;
}

.section-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.current-edit-btn {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.current-pet-card {
  background: linear-gradient(180deg, rgba(255, 255, 252, 0.98) 0%, rgba(250, 252, 245, 0.96) 100%);
}

.current-pet-main {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.current-pet-avatar-wrap {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.current-pet-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 253, 246, 0.98);
  box-shadow: 0 10rpx 22rpx rgba(191, 180, 150, 0.12);
}

.current-pet-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.current-pet-avatar-text {
  color: #fffdf8;
  font-size: 50rpx;
  font-weight: 700;
}

.current-pet-info {
  flex: 1;
  margin-left: 22rpx;
}

.current-pet-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #5a4632;
}

.current-pet-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8f7b67;
}

.current-pet-stats {
  display: flex;
  margin-top: 18rpx;
}

.current-stat {
  flex: 1;
}

.current-stat + .current-stat {
  margin-left: 16rpx;
}

.current-stat-label {
  display: block;
  font-size: 22rpx;
  color: #aa947a;
}

.current-stat-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5a4632;
  font-weight: 700;
}

.current-tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.current-tag {
  margin-top: 10rpx;
  margin-right: 12rpx;
}

.current-reminder {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff8e5 0%, #fffdf2 100%);
  border: 1px solid #f1e0ba;
}

.current-reminder-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.current-reminder-text {
  font-size: 24rpx;
  color: #99763c;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.overview-item {
  padding: 24rpx 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fbfbf3 0%, #fffdf8 100%);
  border: 1px solid #e5e6d7;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(191, 180, 150, 0.06);
}

.overview-value {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: #87996e;
}

.overview-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8f7b67;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-item {
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 246, 0.98);
  border: 1px solid #efe4d1;
  box-shadow: 0 12rpx 24rpx rgba(191, 180, 150, 0.08);
}

.quick-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tone-green {
  background: #eef6e9;
}

.tone-yellow {
  background: #fff4d1;
}

.tone-orange {
  background: #fff0e0;
}

.quick-icon {
  font-size: 34rpx;
  line-height: 1;
}

.quick-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5a4632;
}

.pet-list-card {
  overflow: hidden;
}

.pet-list {
  margin-top: 8rpx;
}

.pet-item {
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffef9 0%, #f9fbf4 100%);
  border: 1px solid #ece2cf;
  box-shadow: 0 10rpx 20rpx rgba(191, 180, 150, 0.06);
}

.pet-item + .pet-item {
  margin-top: 16rpx;
}

.pet-item-active {
  border-color: #d8e2c8;
  box-shadow: 0 14rpx 26rpx rgba(161, 178, 138, 0.12);
}

.pet-item-top {
  display: flex;
  align-items: flex-start;
}

.pet-item-avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pet-item-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 253, 246, 0.98);
  box-shadow: 0 8rpx 16rpx rgba(191, 180, 150, 0.12);
}

.pet-item-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-item-avatar-text {
  color: #fffdf8;
  font-size: 34rpx;
  font-weight: 700;
}

.pet-item-main {
  flex: 1;
  margin-left: 18rpx;
}

.pet-item-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.pet-item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #5a4632;
}

.pet-item-type {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #87996e;
  background: #eef3e5;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.pet-item-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f7b67;
}

.pet-item-reminder {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #aa8848;
}

.pet-item-bottom {
  display: flex;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f0e6d4;
}

.pet-item-stat {
  font-size: 22rpx;
  color: #8f7b67;
}

.pet-item-stat + .pet-item-stat {
  margin-left: 20rpx;
}

.tip-note {
  position: relative;
  margin-top: 4rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx 28rpx 110rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fff6da 0%, #fffdf0 100%);
  border: 1px solid #efe0b6;
  box-shadow: 0 14rpx 28rpx rgba(206, 184, 128, 0.12);
}

.tip-note-badge {
  position: absolute;
  left: 24rpx;
  top: 26rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.tip-note-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #7b6534;
}

.tip-note-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #99763c;
}

.empty-profile-card {
  text-align: center;
  padding: 54rpx 28rpx;
}

.empty-pet-emoji {
  display: block;
  font-size: 88rpx;
  line-height: 1;
}

.empty-pet-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #5a4632;
}

.empty-pet-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #927f69;
}

.empty-pet-btn {
  width: 100%;
  margin-top: 20rpx;
}

.secondary-empty-btn {
  margin-top: 14rpx;
}

.avatar-choice {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fff8ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-right: 14rpx;
  margin-top: 12rpx;
  border: 2rpx solid transparent;
}

.avatar-choice.active {
  border-color: #b1c29e;
  background: #eef3e5;
}

.pet-form-modal {
  max-height: calc(100vh - env(safe-area-inset-top) - 40rpx);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}

.pet-form-modal .field-label {
  line-height: 1.5;
  margin-top: 18rpx;
}

.pet-form-modal .input,
.pet-form-modal .picker-box {
  min-height: 88rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.45;
  color: #5a4632;
}

.pet-form-modal input.input {
  height: 88rpx;
  line-height: 88rpx;
  display: block;
  padding: 0 22rpx;
}

.pet-readonly-box {
  color: #8f7b67;
  background: linear-gradient(180deg, #fcfbf5 0%, #fffdf8 100%);
}

.pet-form-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  bottom: 0;
  background: #fff;
  border-top: 1px solid #f0f0f0;
  padding-top: 16rpx;
  margin-top: 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  z-index: 2;
}

.pet-form-actions .secondary-btn,
.pet-form-actions .primary-btn {
  flex: 1;
}

.pet-form-actions .primary-btn {
  margin-left: 16rpx;
}

.pet-page .mask {
  z-index: 1201;
}

/* Pinterest theme overrides */
.pet-page {
  background: #f5f5f5;
}

.archive-hero,
.current-pet-card,
.overview-item,
.pet-item,
.tip-note,
.empty-profile-card,
.pet-form-modal {
  background: #ffffff;
  border-color: #ebebeb;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.hero-title,
.section-title,
.current-pet-name,
.overview-value,
.pet-item-name,
.empty-pet-title,
.tip-note-title,
.modal-title {
  color: #161616;
}

.hero-sub,
.section-sub,
.current-pet-meta,
.current-stat-label,
.current-stat-value,
.overview-label,
.pet-item-sub,
.pet-item-reminder,
.pet-item-stat,
.empty-pet-copy,
.tip-note-text {
  color: #767676;
}

.hero-btn,
.empty-pet-btn,
.pet-form-actions .primary-btn {
  background: #e60023;
  color: #fff;
}

.secondary-empty-btn,
.current-edit-btn,
.pet-form-actions .secondary-btn {
  background: #fff;
  color: #2d2d2d;
  border-color: #d8d8d8;
}

.hero-paw,
.hero-bubble,
.current-pet-avatar,
.pet-item-avatar,
.avatar-choice {
  border-color: #f0f0f0;
}

.current-reminder,
.tip-note {
  background: #fff2f5;
  border: 1px solid #ffd9e2;
}

.current-reminder-text,
.tip-note-badge {
  color: #a11f3a;
}

.current-tag,
.tag {
  background: #f3f3f3;
  color: #505050;
  border-color: #ececec;
}

.pet-item-active {
  border-color: #e60023;
  box-shadow: 0 12rpx 24rpx rgba(230, 0, 35, 0.16);
}

.pet-item-type {
  background: #ffeef2;
  color: #a62341;
}

.avatar-choice.active {
  border-color: #e60023;
  background: #ffeef2;
  color: #b21638;
}

.input,
.picker-box,
.pet-readonly-box {
  border-color: #e5e5e5;
  color: #1f1f1f;
}
