.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.overview-item {
  padding: 24rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff7dc, #fffdf1);
  border: 1px solid #f0dfb2;
  text-align: center;
}

.overview-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #b58c31;
}

.overview-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8f7a60;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.quick-item {
  padding: 24rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 253, 246, 0.98);
  border: 1px solid #f1e3bc;
  box-shadow: 0 10rpx 24rpx rgba(229, 196, 116, 0.08);
}

.quick-icon {
  display: block;
  font-size: 40rpx;
  line-height: 1;
}

.quick-text {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5a4632;
}

.pet-card {
  padding-bottom: 20rpx;
}

.pet-top {
  display: flex;
  align-items: flex-start;
}

.pet-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f6f6f6;
}

.pet-avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: #fff8ee;
}

.pet-main {
  flex: 1;
  margin-left: 18rpx;
}

.pet-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 12rpx;
  color: #5a4632;
}

.pet-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #92816f;
}

.pet-tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.pet-soft-tag {
  display: inline-block;
  margin-right: 10rpx;
  margin-top: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3cf;
  color: #a17b2f;
  font-size: 22rpx;
}

.pet-like-tag {
  background: #fff8e5;
}

.pet-cta-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.pet-cta-row button,
.pet-cta-row view {
  margin-left: 12rpx;
}

.pet-detail {
  margin-top: 18rpx;
}

.pet-action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.empty-profile-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-pet-emoji {
  display: block;
  font-size: 88rpx;
  line-height: 1;
}

.empty-pet-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #5a4632;
}

.empty-pet-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #927f69;
}

.empty-pet-btn {
  width: 100%;
  margin-top: 20rpx;
}

.secondary-empty-btn {
  margin-top: 14rpx;
}

.tip-card {
  margin-bottom: 24rpx;
}

.tip-copy {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #8f7a60;
}

.avatar-choice {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fff8ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-right: 14rpx;
  margin-top: 12rpx;
  border: 2rpx solid transparent;
}

.avatar-choice.active {
  border-color: #d8b25b;
  background: #f8eed0;
}

.pet-form-modal {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.pet-form-actions {
  padding-bottom: env(safe-area-inset-bottom);
}
