<view class="page-container pet-page profile-page">
  <view class="profile-hero">
    <image class="profile-cover" src="{{profile.cover}}" mode="aspectFill"></image>
    <view class="profile-cover-mask"></view>

    <button class="profile-menu-button" catchtap="toggleProfileMenu">☰</button>

    <view wx:if="{{showProfileMenu}}" class="profile-menu-mask" bindtap="closeProfileMenu">
      <view class="profile-menu-panel" catchtap="noop">
        <view class="profile-menu-group">
          <text class="profile-menu-title">账号</text>
          <view class="profile-menu-item" data-type="editProfile" bindtap="handleMenuAction">
            <text>编辑个人资料</text>
            <text class="profile-menu-arrow">›</text>
          </view>
          <view class="profile-menu-item" data-type="accountSecurity" bindtap="handleMenuAction">
            <text>账号安全</text>
            <text class="profile-menu-arrow">›</text>
          </view>
        </view>

        <view class="profile-menu-group">
          <text class="profile-menu-title">毛孩子</text>
          <view class="profile-menu-item" data-type="petManage" bindtap="handleMenuAction">
            <text>宠物档案管理</text>
            <text class="profile-menu-arrow">›</text>
          </view>
          <view class="profile-menu-item" data-type="reminderManage" bindtap="handleMenuAction">
            <text>提醒管理</text>
            <text class="profile-menu-arrow">›</text>
          </view>
          <view class="profile-menu-item" data-type="identifyHistory" bindtap="handleMenuAction">
            <text>识别历史</text>
            <text class="profile-menu-arrow">›</text>
          </view>
        </view>

        <view class="profile-menu-group profile-menu-last">
          <view class="profile-menu-item danger" data-type="logout" bindtap="handleMenuAction">
            <text>退出登录</text>
          </view>
        </view>
      </view>
    </view>

    <view class="profile-main-info">
      <image class="profile-avatar" src="{{profile.avatar}}" mode="aspectFill"></image>
      <view class="profile-text-block">
        <text class="profile-name">{{profile.nickname}}</text>
        <text class="profile-id">{{profile.profileId}} · IP：{{profile.location}}</text>
        <text class="profile-bio">{{profile.bio}}</text>
      </view>
    </view>

    <view class="profile-stats-row">
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{profile.following}}</text>
        <text class="profile-stat-label">Following</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{profile.followers}}</text>
        <text class="profile-stat-label">Followers</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{profile.likesAndSaves}}</text>
        <text class="profile-stat-label">Likes & Saves</text>
      </view>
    </view>

    <view class="profile-tag-row">
      <block wx:for="{{profile.tags}}" wx:key="*this">
        <text class="profile-tag">{{item}}</text>
      </block>
    </view>
  </view>

  <view class="profile-section profile-post-section">
    <view class="profile-content-head">
      <text class="profile-content-title">我的内容</text>
      <text class="profile-content-sub">记录、收藏和喜欢都在这里</text>
    </view>

    <view class="profile-tabs">
      <block wx:for="{{tabs}}" wx:key="key">
        <view class="profile-tab {{activeTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="handleTabTap">
          <text class="profile-tab-label">{{item.label}}</text>
          <text class="profile-tab-count">{{item.count}}</text>
        </view>
      </block>
    </view>

    <view wx:if="{{currentTabPosts.length}}" class="profile-post-grid">
      <block wx:for="{{currentTabPosts}}" wx:key="id">
        <view class="profile-post-card" data-id="{{item.id}}" bindtap="handlePostTap">
          <image class="profile-post-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="profile-post-body">
            <text class="profile-post-title">{{item.title}}</text>
            <text class="profile-post-summary">{{item.summary}}</text>
            <view class="profile-post-meta-row">
              <text class="profile-post-chip">{{item.category}}</text>
              <text class="profile-post-date">{{item.createdDate}}</text>
            </view>
            <view class="profile-post-actions">
              <text>♡ {{item.likeCount}}</text>
              <text>☆ {{item.favoriteCount}}</text>
              <text>💬 {{item.commentCount}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view wx:else class="profile-post-empty">
      <text class="profile-post-empty-title">{{activeTab === 'posts' ? '还没有发布过帖子' : '这里暂时空空的'}}</text>
      <text class="profile-post-empty-copy">{{activeTab === 'posts' ? '去社区分享毛孩子的可爱瞬间吧' : '遇到喜欢的内容，可以轻轻点亮它'}}</text>
    </view>
  </view>

  <pet-tabbar current="pet"></pet-tabbar>
</view>
