<view class="page-container pet-page profile-page">
  <view class="profile-hero">
    <image class="profile-cover" src="{{profile.cover}}" mode="aspectFill"></image>
    <view class="profile-cover-mask"></view>

    <view class="profile-top-actions">
      <button class="profile-edit-btn" bindtap="handleEditProfile">编辑账号资料</button>
      <button class="profile-edit-btn" bindtap="handleOpenPasswordForm">修改密码</button>
      <button class="profile-logout-btn" bindtap="handleLogout">退出登录</button>
    </view>

    <view class="profile-main-info">
      <image class="profile-avatar" src="{{profile.avatar}}" mode="aspectFill"></image>
      <view class="profile-text-block">
        <text class="profile-name">{{profile.nickname}}</text>
        <text class="profile-id">{{profile.profileId}} · IP：{{profile.location}}</text>
        <text class="profile-bio">{{profile.bio}}</text>
      </view>
    </view>

    <view class="profile-stats-row">
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{profile.following}}</text>
        <text class="profile-stat-label">Following</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{profile.followers}}</text>
        <text class="profile-stat-label">Followers</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-value">{{profile.likesAndSaves}}</text>
        <text class="profile-stat-label">Likes & Saves</text>
      </view>
    </view>

    <view class="profile-tag-row">
      <block wx:for="{{profile.tags}}" wx:key="*this">
        <text class="profile-tag">{{item}}</text>
      </block>
    </view>
  </view>

  <block wx:if="{{petList.length}}">
    <view class="profile-section pet-section">
      <view class="section-row profile-section-head">
        <view>
          <text class="profile-section-title">宠物信息</text>
          <text class="profile-section-sub">横向滑动查看全部毛孩子</text>
        </view>
        <button class="small-btn profile-add-pet" bindtap="handleAddPet">+ 新增</button>
      </view>

      <scroll-view class="pet-card-scroll" scroll-x enable-flex show-scrollbar="false">
        <block wx:for="{{petList}}" wx:key="id">
          <view class="profile-pet-card {{currentPetId === item.id ? 'active' : ''}}" bindtap="handlePetTap" data-id="{{item.id}}">
            <view class="profile-pet-card-top">
              <view class="profile-pet-avatar-wrap" style="background: {{item.softColor}};">
                <image wx:if="{{item.avatarType === 'image'}}" class="profile-pet-avatar" src="{{item.avatarValue}}" mode="aspectFill"></image>
                <view wx:else class="profile-pet-avatar profile-pet-avatar-fallback" style="background: {{item.color}};">
                  <text>{{item.avatarValue || item.initial}}</text>
                </view>
              </view>

              <view class="profile-pet-main">
                <view class="profile-pet-name-row">
                  <view class="profile-pet-title-area">
                    <text class="profile-pet-name">{{item.name}}</text>
                  </view>
                </view>
                <text class="profile-pet-meta">{{item.breed}} · {{item.gender}} · {{item.ageText}}</text>
              </view>
            </view>

            <view class="profile-pet-info-grid">
              <view class="profile-pet-info-item">
                <text class="profile-pet-info-label">生日</text>
                <text class="profile-pet-info-value">{{item.birthday || '未填写'}}</text>
              </view>
              <view class="profile-pet-info-item">
                <text class="profile-pet-info-label">体重</text>
                <text class="profile-pet-info-value">{{item.weight}}</text>
              </view>
            </view>

            <view class="profile-pet-tags">
              <block wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">
                <text class="profile-pet-tag">{{tag}}</text>
              </block>
            </view>

            <view class="profile-pet-bottom-row">
              <text class="profile-pet-reminder">下次提醒：{{item.nextReminder}}</text>
              <view class="profile-pet-card-actions">
                <button class="profile-pet-delete-btn" data-id="{{item.id}}" catchtap="deletePet">删除</button>
                <button class="profile-pet-edit-btn" data-id="{{item.id}}" catchtap="handleEditPet">编辑</button>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </block>

  <view wx:else class="profile-empty-pets">
    <text class="empty-pet-emoji">🐾</text>
    <text class="empty-pet-title">还没有毛孩子的档案</text>
    <text class="empty-pet-copy">先为它建立一张专属萌宠名片吧</text>
    <button class="primary-btn empty-pet-btn" bindtap="handleCreateFirstPet">+ 创建第一只宠物</button>
  </view>

  <view class="profile-section profile-post-section">
    <view class="profile-tabs">
      <block wx:for="{{tabs}}" wx:key="key">
        <view class="profile-tab {{activeTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="handleTabTap">
          <text class="profile-tab-label">{{item.label}}</text>
          <text class="profile-tab-count">{{item.count}}</text>
        </view>
      </block>
    </view>

    <view wx:if="{{currentTabPosts.length}}" class="profile-post-grid">
      <block wx:for="{{currentTabPosts}}" wx:key="id">
        <view class="profile-post-card" data-id="{{item.id}}" bindtap="handlePostTap">
          <image class="profile-post-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="profile-post-body">
            <text class="profile-post-title">{{item.title}}</text>
            <text class="profile-post-summary">{{item.summary}}</text>
            <view class="profile-post-meta-row">
              <text class="profile-post-chip">{{item.category}}</text>
              <text class="profile-post-date">{{item.createdDate}}</text>
            </view>
            <view class="profile-post-actions">
              <text>♡ {{item.likeCount}}</text>
              <text>☆ {{item.favoriteCount}}</text>
              <text>💬 {{item.commentCount}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view wx:else class="profile-post-empty">
      <text class="profile-post-empty-title">暂无内容</text>
      <text class="profile-post-empty-copy">切换其他分类或去社区发布一条新动态</text>
    </view>
  </view>

  <!-- 编辑账号资料 -->
  <view wx:if="{{showProfileForm}}" class="mask" bindtap="closeProfileForm">
    <view class="modal profile-account-modal" catchtap="noop">
      <text class="modal-title">编辑账号资料</text>

      <text class="field-label">昵称</text>
      <input class="input" placeholder="请输入昵称" value="{{profileForm.nickname}}" data-field="nickname" bindinput="bindProfileInput" />

      <text class="field-label">账号 ID</text>
      <view class="picker-box pet-readonly-box">{{profileForm.profileId}}</view>

      <text class="field-label">地区</text>
      <input class="input" placeholder="例如：天津" value="{{profileForm.location}}" data-field="location" bindinput="bindProfileInput" />

      <text class="field-label">个人简介</text>
      <textarea class="textarea profile-bio-textarea" placeholder="写一句介绍自己和毛孩子的话" value="{{profileForm.bio}}" data-field="bio" bindinput="bindProfileInput"></textarea>

      <text class="field-label">资料标签</text>
      <input class="input" placeholder="用顿号或逗号分隔，例如：南开大学、猫狗双全" value="{{profileForm.tagsText}}" data-field="tagsText" bindinput="bindProfileInput" />

      

      <text class="field-label">头像</text>
      <view class="profile-form-image-row">
        <image class="profile-form-preview-avatar" src="{{profileForm.avatar}}" mode="aspectFill"></image>
        <button class="secondary-btn profile-form-image-btn" data-field="avatar" bindtap="uploadProfileImage">上传头像</button>
      </view>

      <text class="field-label">主页背景图</text>
      <view class="profile-form-cover-box">
        <image class="profile-form-preview-cover" src="{{profileForm.cover}}" mode="aspectFill"></image>
        <button class="secondary-btn profile-form-cover-btn" data-field="cover" bindtap="uploadProfileImage">更换背景图</button>
      </view>

      <view class="modal-actions profile-form-actions">
        <button class="secondary-btn" catchtap="closeProfileForm">取消</button>
        <button class="primary-btn" catchtap="saveProfile">保存账号资料</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showPasswordForm}}" class="mask" bindtap="closePasswordForm">
    <view class="modal profile-account-modal" catchtap="noop">
      <text class="modal-title">修改密码</text>

      <text class="field-label">当前密码</text>
      <input class="input" password placeholder="请输入当前密码" value="{{passwordForm.currentPassword}}" data-field="currentPassword" bindinput="bindPasswordInput" />

      <text class="field-label">新密码</text>
      <input class="input" password placeholder="至少 6 位" value="{{passwordForm.nextPassword}}" data-field="nextPassword" bindinput="bindPasswordInput" />

      <text class="field-label">确认新密码</text>
      <input class="input" password placeholder="再次输入新密码" value="{{passwordForm.confirmPassword}}" data-field="confirmPassword" bindinput="bindPasswordInput" />

      <view class="modal-actions profile-form-actions">
        <button class="secondary-btn" catchtap="closePasswordForm">取消</button>
        <button class="primary-btn" catchtap="submitPasswordChange">确认修改</button>
      </view>
    </view>
  </view>

  <!-- 新增 / 编辑宠物资料 -->
  <view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
    <view class="modal pet-form-modal" catchtap="noop">
      <text class="modal-title">{{formMode === 'add' ? '新增宠物' : '编辑宠物'}}</text>

      <text class="field-label">宠物名称</text>
      <input class="input" placeholder="例如：奶糖" value="{{form.name}}" data-field="name" bindinput="bindInput" />

      <text class="field-label">宠物类别</text>
      <input class="input" placeholder="例如：猫咪 / 狗狗" value="{{form.type}}" data-field="type" bindinput="bindInput" />

      <text class="field-label">品种</text>
      <input class="input" placeholder="例如：蓝金渐层长毛猫 / 萨摩耶" value="{{form.breed}}" data-field="breed" bindinput="bindInput" />

      <text class="field-label">性别</text>
      <input class="input" placeholder="例如：弟弟 / 妹妹" value="{{form.gender}}" data-field="gender" bindinput="bindInput" />

      <text class="field-label">生日</text>
      <picker mode="date" value="{{form.birthday}}" bindchange="changeBirthday">
        <view class="picker-box">{{form.birthday || '请选择生日'}}</view>
      </picker>

      <text class="field-label">年龄</text>
      <view class="picker-box pet-readonly-box">{{form.age || '填写生日后自动计算'}}</view>

      <text class="field-label">体重</text>
      <input class="input" placeholder="例如：4.2kg" value="{{form.weight}}" data-field="weight" bindinput="bindInput" />

      <text class="field-label">喜好</text>
      <input class="input" placeholder="例如：喜欢罐头、爱散步" value="{{form.likes}}" data-field="likes" bindinput="bindInput" />

      <text class="field-label">性格</text>
      <input class="input" placeholder="例如：温顺、活泼、黏人" value="{{form.personality}}" data-field="personality" bindinput="bindInput" />

      <text class="field-label">下一次提醒</text>
      <input class="input" placeholder="例如：5月20日 驱虫提醒" value="{{form.nextReminder}}" data-field="nextReminder" bindinput="bindInput" />

      <text class="field-label">默认头像</text>
      <view class="flex-wrap">
        <block wx:for="{{defaultAvatars}}" wx:key="*this">
          <view class="avatar-choice {{form.avatarType === 'emoji' && form.avatarValue === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseDefaultAvatar">
            {{item}}
          </view>
        </block>
      </view>

      <text class="field-label">或上传自定义头像</text>
      <button class="secondary-btn mt12" bindtap="uploadAvatar">上传头像</button>

      <view class="modal-actions pet-form-actions">
        <button wx:if="{{formMode === 'edit' && form.id}}" class="danger-btn" data-id="{{form.id}}" catchtap="deletePet">删除宠物</button>
        <button class="secondary-btn" catchtap="closeForm">取消</button>
        <button class="primary-btn" catchtap="savePet">保存宠物资料</button>
      </view>
    </view>
  </view>

  <pet-tabbar current="pet"></pet-tabbar>
</view>
