.simple-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 150rpx;
  box-sizing: border-box;
  background: #FFFDF6;
  color: #5B4A3A;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
}

.page-sub {
  display: block;
  margin-top: 10rpx;
  color: #9A8B7A;
  font-size: 24rpx;
}

.form-list {
  margin-top: 28rpx;
  background: rgba(238, 245, 234, 0.34);
  border-radius: 28rpx;
  padding: 0 22rpx;
}

.form-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  border-bottom: 1px solid rgba(156, 175, 136, 0.18);
}

.notice-row {
  padding: 18rpx 0;
  color: #9A8B7A;
  font-size: 23rpx;
  line-height: 1.6;
  border-bottom: 1px solid rgba(156, 175, 136, 0.18);
}

.form-label {
  width: 180rpx;
  flex-shrink: 0;
  color: #7F6F5E;
  font-weight: 800;
}

.form-label.block {
  width: auto;
  display: block;
  margin-bottom: 12rpx;
}

.picker-value {
  color: #5B4A3A;
  text-align: right;
}

.form-block {
  padding: 24rpx 0;
  border-bottom: 1px solid rgba(156, 175, 136, 0.18);
}

.title-input {
  flex: 1;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #FFFDF6;
}

.subtask-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #7F956D;
  font-size: 24rpx;
  font-weight: 800;
}

.mini-btn::after {
  border: none;
}

.subtask-list {
  margin-top: 14rpx;
}

.subtask-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1px solid rgba(156, 175, 136, 0.14);
  color: #5B4A3A;
  font-size: 24rpx;
}

.remove-subtask {
  color: #B56A53;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #FFFDF6;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 246, 0.96);
}

.primary-action {
  background: #9CAF88;
  color: #FFFDF6;
  border-radius: 999rpx;
  font-weight: 800;
}

.primary-action::after {
  border: none;
}
