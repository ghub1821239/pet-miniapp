<view class="page-container publish-page">
  <view class="publish-tip">
    <text class="publish-tip-title">{{pageTitle}}</text>
    <text class="publish-tip-sub">{{pageSubtitle}}</text>
  </view>

  <view class="card publish-card">
    <text class="section-title">动态内容</text>

    <view class="publish-action-row">
      <button class="secondary-btn publish-media-btn publish-media-btn-album" bindtap="chooseAlbumMedia">从相册选择</button>
      <button class="secondary-btn publish-media-btn publish-media-btn-camera" bindtap="chooseCameraMedia">直接拍摄</button>
    </view>

    <view wx:if="{{form.images.length > 0}}" class="publish-media-list">
      <block wx:for="{{form.images}}" wx:key="*this">
        <image class="publish-thumb" src="{{item}}" mode="aspectFill"></image>
      </block>
    </view>

    <view wx:if="{{form.videoCover}}" class="publish-video-box">
      <image class="publish-video-cover" src="{{form.videoCover}}" mode="aspectFill"></image>
      <text class="publish-video-tag">视频封面</text>
    </view>

    <text class="field-label">标题</text>
    <input class="input publish-input" placeholder="写一个简短标题" value="{{form.title}}" data-field="title" bindinput="bindInput" />

    <text class="field-label">正文</text>
    <textarea class="textarea publish-textarea" placeholder="分享今天发生的可爱瞬间..." value="{{form.content}}" data-field="content" bindinput="bindInput"></textarea>

    <text class="field-label">关联宠物</text>
    <picker range="{{petNames}}" value="{{petIndex}}" bindchange="changePet">
      <view class="picker-box publish-picker">{{petNames[petIndex]}}</view>
    </picker>

    <text class="field-label">帖子分区</text>
    <picker range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="changeCategory">
      <view class="picker-box publish-picker">{{categoryOptions[categoryIndex]}}</view>
    </picker>

    <text class="field-label">标签</text>
    <input class="input publish-input" placeholder="自定义标签，多个可用空格或逗号分隔" value="{{form.tagsText}}" data-field="tagsText" bindinput="bindInput" />
    <view class="publish-tag-list">
      <block wx:for="{{tagOptions}}" wx:key="*this">
        <text class="publish-tag-chip {{selectedTags.indexOf(item) > -1 ? 'active' : ''}}" data-tag="{{item}}" bindtap="handleTagTap">{{item}}</text>
      </block>
    </view>

    <view class="publish-switch-row">
      <text class="field-label publish-inline-label">显示位置</text>
      <switch checked="{{form.showLocation}}" color="#9CAF88" bindchange="switchLocation" />
    </view>
    <view wx:if="{{form.showLocation}}" class="publish-location-row">
      <view class="picker-box publish-picker publish-location-text">{{form.locationText || '未选择位置，发布时将自动定位'}}</view>
      <button class="secondary-btn publish-location-btn" bindtap="chooseLocation">选择位置</button>
    </view>

    <view wx:if="{{entryMode === 'community' || visibility === 'public'}}" class="publish-promotion-card" bindtap="openPromotionSheet">
      <view class="publish-promotion-main">
        <text class="publish-promotion-title">推广核销</text>
        <text class="publish-promotion-sub">{{selectedPromotionPackage ? selectedPromotionPackage.title + ' · ' + (promotionCode ? '密钥已填写' : '待填写密钥') : '可选，选择套餐并输入优惠码/密钥'}}</text>
      </view>
      <view class="publish-promotion-action">{{selectedPromotionPackage ? '更换' : '选择套餐'}}</view>
    </view>

    <button class="primary-btn publish-submit" loading="{{promotionPaying}}" disabled="{{promotionPaying}}" bindtap="submitPost">{{submitButtonText}}</button>
  </view>

  <view wx:if="{{promotionSheetVisible}}" class="mask publish-promotion-mask" bindtap="closePromotionSheet">
    <view class="modal publish-promotion-sheet" catchtap="noop">
      <text class="modal-title">选择推流套餐</text>
      <text class="publish-promotion-sheet-sub">当前为演示模式：输入后端维护的优惠码或密钥，核销成功后立即开启推流。</text>

      <block wx:for="{{promotionPackages}}" wx:key="id">
        <view class="promotion-package {{selectedPromotionPackageId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectPromotionPackage">
          <view class="promotion-package-copy">
            <text class="promotion-package-title">{{item.title}}</text>
            <text class="promotion-package-desc">{{item.desc}}</text>
          </view>
          <view class="promotion-package-price">¥{{item.price}}</view>
        </view>
      </block>

      <view class="promotion-code-panel">
        <text class="promotion-code-title">输入优惠码 / 推流密钥</text>
        <input
          class="input publish-input promotion-code-input"
          placeholder="例如：PROMO-7DAY-001"
          value="{{promotionCode}}"
          bindinput="bindPromotionCodeInput"
        />
      </view>

      <view class="modal-actions publish-promotion-actions">
        <button class="secondary-btn" bindtap="clearPromotionPackage">暂不推流</button>
        <button class="primary-btn" bindtap="confirmPromotionPackage">确认核销信息</button>
      </view>
    </view>
  </view>
</view>
