.publish-page {
  padding-top: 18rpx;
}

.publish-tip {
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.publish-tip-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #5b4a3a;
}

.publish-tip-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #968472;
}

.publish-card {
  padding-top: 18rpx;
}

.publish-action-row {
  display: flex;
  margin-top: 12rpx;
  gap: 16rpx;
}

.publish-action-row button {
  flex: 1;
  margin-right: 0;
}

.publish-media-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.publish-thumb {
  width: 31%;
  height: 200rpx;
  border-radius: 18rpx;
  margin-right: 2%;
  margin-bottom: 12rpx;
  background: #f7f2e5;
}

.publish-video-box {
  position: relative;
  margin-top: 18rpx;
}

.publish-video-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  background: #f7f2e5;
}

.publish-video-tag {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(90, 70, 50, 0.72);
  color: #fffef8;
  font-size: 22rpx;
}

.publish-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.publish-tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  gap: 12rpx;
}

.publish-tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef5ea;
  color: #87966f;
  font-size: 24rpx;
  line-height: 1.2;
  border: 1px solid #e1ead7;
}

.publish-tag-chip.active {
  background: linear-gradient(180deg, #acc28d, #95ac78);
  color: #fffdf8;
  border-color: #95ac78;
}

.publish-inline-label {
  margin-top: 0;
}

.publish-input,
.publish-picker {
  height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  color: #5a4632;
}

.publish-textarea {
  min-height: 260rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5a4632;
}

.publish-submit {
  width: 78%;
  margin: 28rpx auto 0;
  display: block;
}

.publish-page .field-label {
  margin-top: 18rpx;
}

.publish-page .section-title {
  margin-top: 8rpx;
}

.publish-page .secondary-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.publish-media-btn {
  border-width: 2rpx;
  border-style: solid;
  box-shadow: 0 10rpx 20rpx rgba(149, 172, 120, 0.12);
}

.publish-media-btn-album {
  background: linear-gradient(180deg, #fff7dd, #f8e7b7);
  color: #b58435;
  border-color: #f0d493;
  box-shadow: 0 10rpx 20rpx rgba(240, 210, 133, 0.18);
}

.publish-media-btn-camera {
  background: linear-gradient(180deg, #acc28d, #95ac78);
  color: #fffdf8;
  border-color: #95ac78;
  box-shadow: 0 10rpx 20rpx rgba(149, 172, 120, 0.18);
}
