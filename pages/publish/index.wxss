.publish-page {
  padding-top: 18rpx;
  background: #FCE7C8;
}

.publish-tip {
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.publish-tip-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.publish-tip-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9A8B7A;
}

.publish-card {
  padding-top: 18rpx;
}

.publish-action-row {
  display: flex;
  margin-top: 12rpx;
  gap: 16rpx;
}

.publish-action-row button {
  flex: 1;
  margin-right: 0;
}

.publish-media-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.publish-thumb {
  width: 31%;
  height: 200rpx;
  border-radius: 18rpx;
  margin-right: 2%;
  margin-bottom: 12rpx;
  background: #FFF8E5;
}

.publish-video-box {
  position: relative;
  margin-top: 18rpx;
}

.publish-video-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  background: #FFF8E5;
}

.publish-video-tag {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(91, 74, 58, 0.78);
  color: #FFFDF6;
  font-size: 22rpx;
}

.publish-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.publish-location-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.publish-location-text {
  flex: 1;
  min-width: 0;
  color: #9A8B7A;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.publish-location-btn {
  flex-shrink: 0;
  margin-right: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.publish-tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  gap: 12rpx;
}

.publish-tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #5B4A3A;
  font-size: 24rpx;
  line-height: 1.2;
  border: 1px solid #e9e9e9;
}

.publish-tag-chip.active {
  background: #9CAF88;
  color: #FFFDF6;
  border-color: #9CAF88;
}

.publish-inline-label {
  margin-top: 0;
}

.publish-input,
.publish-picker {
  height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  color: #5B4A3A;
}

.publish-textarea {
  min-height: 260rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5B4A3A;
}

.publish-submit {
  width: 78%;
  margin: 28rpx auto 0;
  display: block;
}

.publish-page .field-label {
  margin-top: 18rpx;
}

.publish-page .section-title {
  margin-top: 8rpx;
}

.publish-page .secondary-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.publish-media-btn {
  border-width: 2rpx;
  border-style: solid;
}

.publish-media-btn-album {
  background: #FFFDF6;
  color: #5B4A3A;
  border-color: rgba(250, 218, 122, 0.55);
}

.publish-media-btn-camera {
  background: #EEF5EA;
  color: #7F956D;
  border-color: #FADA7A;
}
