.publish-page {
  padding-top: 18rpx;
  background: #FCE7C8;
}

.publish-tip {
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.publish-tip-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.publish-tip-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9A8B7A;
}

.publish-card {
  padding-top: 18rpx;
}

.publish-action-row {
  display: flex;
  margin-top: 12rpx;
  gap: 16rpx;
}

.publish-action-row button {
  flex: 1;
  margin-right: 0;
}

.publish-media-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.publish-thumb {
  width: 31%;
  height: 200rpx;
  border-radius: 18rpx;
  margin-right: 2%;
  margin-bottom: 12rpx;
  background: #FFF8E5;
}

.publish-video-box {
  position: relative;
  margin-top: 18rpx;
}

.publish-video-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  background: #FFF8E5;
}

.publish-video-tag {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(91, 74, 58, 0.78);
  color: #FFFDF6;
  font-size: 22rpx;
}

.publish-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.publish-location-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.publish-location-text {
  flex: 0 1 calc(100% - 224rpx);
  min-width: 0;
  color: #9A8B7A;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.publish-location-btn {
  flex-shrink: 0;
  width: 214rpx;
  margin-right: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  font-size: 24rpx;
}

.publish-tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  gap: 12rpx;
}

.publish-tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #EEF5EA;
  color: #5B4A3A;
  font-size: 24rpx;
  line-height: 1.2;
  border: 1px solid #e9e9e9;
}

.publish-tag-chip.active {
  background: #9CAF88;
  color: #FFFDF6;
  border-color: #9CAF88;
}

.publish-inline-label {
  margin-top: 0;
}

.publish-input,
.publish-picker {
  height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  color: #5B4A3A;
}

.publish-textarea {
  min-height: 260rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5B4A3A;
}

.publish-submit {
  width: 78%;
  margin: 28rpx auto 0;
  display: block;
}

.publish-promotion-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF4DD 0%, #EEF5EA 100%);
  border: 1px solid rgba(250, 218, 122, 0.58);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 20rpx rgba(91, 74, 58, 0.05);
}

.publish-promotion-main {
  flex: 1;
  min-width: 0;
}

.publish-promotion-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.publish-promotion-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A8B7A;
  line-height: 1.5;
}

.publish-promotion-action {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #9CAF88;
  color: #FFFDF6;
  font-size: 24rpx;
  font-weight: 800;
}

.publish-promotion-sheet {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.publish-promotion-sheet-sub {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 18rpx;
  color: #9A8B7A;
  font-size: 24rpx;
  line-height: 1.6;
}

.promotion-package {
  margin-top: 14rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #FFFDF6;
  border: 1px solid rgba(250, 218, 122, 0.45);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.promotion-package-copy {
  flex: 1;
  min-width: 0;
}

.promotion-package.active {
  border-color: #9CAF88;
  background: #EEF5EA;
  box-shadow: 0 8rpx 20rpx rgba(127, 149, 109, 0.12);
}

.promotion-package-title {
  display: block;
  font-size: 29rpx;
  font-weight: 800;
  color: #5B4A3A;
}

.promotion-package-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9A8B7A;
}

.promotion-package-price {
  margin-left: 18rpx;
  flex-shrink: 0;
  align-self: center;
  color: #7F956D;
  font-size: 34rpx;
  font-weight: 900;
}

.promotion-code-panel {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #FFF8EA 0%, #FFFDF6 100%);
  border: 1px solid rgba(250, 218, 122, 0.42);
}

.promotion-code-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5B4A3A;
}

.promotion-code-input {
  margin-top: 14rpx;
  background: #FFFFFF;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.publish-promotion-actions {
  gap: 18rpx;
}

.publish-promotion-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.publish-promotion-actions button {
  flex: 1;
  margin: 0;
}

.publish-page .field-label {
  margin-top: 18rpx;
}

.publish-page .section-title {
  margin-top: 8rpx;
}

.publish-page .secondary-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.publish-media-btn {
  border-width: 2rpx;
  border-style: solid;
}

.publish-media-btn-album {
  background: #FFFDF6;
  color: #5B4A3A;
  border-color: rgba(250, 218, 122, 0.55);
}

.publish-media-btn-camera {
  background: #EEF5EA;
  color: #7F956D;
  border-color: #FADA7A;
}
