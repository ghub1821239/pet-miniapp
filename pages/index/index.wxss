.diary-page {
  color: #5a4632;
}

.diary-hero {
  background: linear-gradient(135deg, #fbf6e8 0%, #fff7de 46%, #f5f7ee 100%);
  box-shadow: 0 18rpx 38rpx rgba(184, 176, 144, 0.13);
}

.hero-eyebrow {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(243, 247, 234, 0.92);
  color: #8b9b72;
  font-size: 22rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.hero-tag {
  display: inline-block;
  margin-right: 12rpx;
  margin-top: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 233, 0.95);
  color: #aa8848;
  font-size: 22rpx;
}

.section-copy {
  display: block;
  color: #8f7b67;
  font-size: 26rpx;
  line-height: 1.8;
}

.note-box {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f7f7eb, #fffdf3);
  border: 1px solid #e5e6d7;
}

.note-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #3e332f;
}

.note-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8f7b67;
}

.roadmap-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
}

.roadmap-item + .roadmap-item {
  border-top: 1px solid #f1e5c6;
}

.roadmap-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  margin-right: 16rpx;
  background: #a8be8b;
  flex-shrink: 0;
}

.roadmap-content {
  flex: 1;
}

.roadmap-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #3e332f;
}

.roadmap-copy {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8f7b67;
}
