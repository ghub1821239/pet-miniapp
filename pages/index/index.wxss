.diary-page {
  color: #5a4632;
  background: linear-gradient(180deg, #fbf6ea 0%, #fdf9ef 36%, #f7f8ef 100%);
}

.diary-hero {
  background: linear-gradient(135deg, #fff9ea 0%, #fff4cf 52%, #f1f5e9 100%);
  box-shadow: 0 18rpx 38rpx rgba(184, 176, 144, 0.13);
}

.hero-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9a856c;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.hero-tag {
  display: inline-block;
  margin-right: 12rpx;
  margin-top: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 241, 0.94);
  color: #9c8b60;
  font-size: 22rpx;
  border: 1px solid #efe3c3;
}

.section-head {
  margin-bottom: 18rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 148rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffdf7 0%, #f6f8ef 100%);
  border: 1px solid #e7e2cf;
  box-shadow: 0 12rpx 24rpx rgba(186, 177, 144, 0.1);
}

.quick-icon {
  font-size: 38rpx;
  line-height: 1;
}

.quick-label {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #5a4632;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.overview-item {
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
  text-align: center;
  background: linear-gradient(180deg, #fffdf7 0%, #f5f8ef 100%);
  border: 1px solid #e8e1cf;
}

.overview-value {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #7f906f;
}

.overview-suffix {
  font-size: 22rpx;
  margin-left: 4rpx;
}

.overview-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #98836e;
}

.timeline-list {
  position: relative;
}

.timeline-item {
  position: relative;
  padding-left: 34rpx;
  padding-bottom: 24rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-line {
  position: absolute;
  left: 11rpx;
  top: 16rpx;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(180deg, #d7e0c7 0%, #efe3c4 100%);
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #b1c29e 0%, #9db18a 100%);
  box-shadow: 0 8rpx 18rpx rgba(160, 180, 137, 0.28);
}

.timeline-main {
  position: relative;
}

.timeline-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.timeline-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #5a4632;
}

.timeline-visibility {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #a87d4a;
  background: #fff4db;
}

.timeline-visibility.is-public {
  color: #7f906f;
  background: #eef3e5;
}

.timeline-card-inner {
  border-radius: 26rpx;
  background: rgba(255, 255, 252, 0.98);
  border: 1px solid #ede2cf;
  box-shadow: 0 14rpx 28rpx rgba(188, 176, 145, 0.1);
  overflow: hidden;
}

.timeline-photo {
  width: 100%;
  height: 260rpx;
  display: block;
}

.timeline-cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
  padding: 24rpx;
  background: linear-gradient(180deg, #fff9e7 0%, #f4f7ed 100%);
  border-bottom: 1px solid #efe5d3;
}

.timeline-cover-icon {
  font-size: 44rpx;
}

.timeline-cover-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9d8b78;
}

.timeline-meta {
  padding: 24rpx;
}

.timeline-pet {
  display: flex;
  align-items: center;
}

.timeline-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef3e5;
  color: #7f906f;
  font-weight: 700;
  font-size: 28rpx;
  flex-shrink: 0;
}

.timeline-pet-copy {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.timeline-pet-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #5a4632;
}

.timeline-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9d8b78;
}

.timeline-title {
  display: block;
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #5a4632;
}

.timeline-content {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #8f7b67;
}

.timeline-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.timeline-tag {
  margin-top: 10rpx;
}

.diary-empty {
  padding: 56rpx 20rpx 30rpx;
}

.empty-icon {
  display: block;
  font-size: 56rpx;
  line-height: 1;
}

.empty-title {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #5a4632;
}

.empty-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9d8b78;
}

.empty-btn {
  margin-top: 28rpx;
}

.fab-add {
  position: fixed;
  right: 28rpx;
  bottom: 212rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #b1c29e 0%, #99ad82 100%);
  box-shadow: 0 18rpx 30rpx rgba(160, 180, 137, 0.3);
  border: 4rpx solid rgba(255, 253, 246, 0.95);
  z-index: 20;
}

.fab-plus {
  color: #fffdf7;
  font-size: 50rpx;
  line-height: 1;
  margin-top: -4rpx;
}
