<view class="page-container diary-page">
  <view class="hero diary-hero">
    <text class="hero-eyebrow">{{hero.eyebrow}}</text>
    <text class="hero-title">{{hero.title}}</text>
    <text class="hero-sub">{{hero.subtitle}}</text>

    <view class="hero-tags">
      <block wx:for="{{hero.tags}}" wx:key="*this">
        <text class="hero-tag">{{item}}</text>
      </block>
    </view>
  </view>

  <view class="card">
    <text class="section-title">页面说明</text>
    <text class="section-copy">{{intro.description}}</text>

    <view class="note-box">
      <text class="note-title">当前阶段</text>
      <text class="note-copy">{{intro.status}}</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">后续可扩展</text>
    <block wx:for="{{roadmap}}" wx:key="title">
      <view class="roadmap-item">
        <view class="roadmap-dot"></view>
        <view class="roadmap-content">
          <text class="roadmap-title">{{item.title}}</text>
          <text class="roadmap-copy">{{item.description}}</text>
        </view>
      </view>
    </block>
  </view>

  <pet-tabbar current="diary"></pet-tabbar>
</view>
